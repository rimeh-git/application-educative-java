<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>{% if dejaConfirmee %}Déjà confirmée{% else %}Présence confirmée !{% endif %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Segoe UI', sans-serif; }

        @keyframes popIn {
            0%   { transform: scale(0) rotate(-15deg); opacity: 0; }
            60%  { transform: scale(1.2) rotate(5deg); opacity: 1; }
            100% { transform: scale(1) rotate(0deg); }
        }
        @keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to   { transform: translateY(0); opacity: 1; }
        }
        @keyframes shimmer {
            0%   { background-position: -200% center; }
            100% { background-position: 200% center; }
        }
        @keyframes pulse-ring {
            0%   { transform: scale(1); opacity: .8; }
            100% { transform: scale(1.6); opacity: 0; }
        }
        @keyframes confetti-fall {
            0%   { transform: translateY(-20px) rotate(0deg); opacity: 1; }
            100% { transform: translateY(100vh) rotate(720deg); opacity: 0; }
        }
        @keyframes xpFill {
            from { width: 0%; }
        }

        .pop-in    { animation: popIn 0.7s cubic-bezier(.36,.07,.19,.97) both; }
        .slide-up  { animation: slideUp 0.5s ease both; }
        .shimmer-gold {
            background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 40%, #f59e0b 60%, #fbbf24 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: shimmer 1.8s linear infinite;
        }
        .pulse-ring {
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            border: 3px solid #10b981;
            animation: pulse-ring 1.5s ease-out infinite;
        }
        .xp-bar { animation: xpFill 1.2s ease-out 0.6s both; }

        .confetti {
            position: fixed;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            animation: confetti-fall linear forwards;
            pointer-events: none;
        }

        .delay-1 { animation-delay: .1s; }
        .delay-2 { animation-delay: .2s; }
        .delay-3 { animation-delay: .35s; }
        .delay-4 { animation-delay: .5s; }
        .delay-5 { animation-delay: .65s; }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-3
    {% if dejaConfirmee %}bg-gradient-to-br from-slate-100 to-slate-200
    {% else %}bg-gradient-to-br from-emerald-400 via-teal-500 to-indigo-600{% endif %}">

{% if not dejaConfirmee %}
{# Confettis #}
<div id="confetti-container"></div>
{% endif %}

{% if dejaConfirmee %}
{# ════════════════════════════════════════
   DÉJÀ CONFIRMÉE
════════════════════════════════════════ #}
<div class="bg-white rounded-3xl shadow-xl max-w-sm w-full p-7 text-center">
    <div class="w-16 h-16 bg-amber-100 rounded-full flex items-center justify-center mx-auto mb-4">
        <i class="fas fa-clock text-amber-500 text-3xl"></i>
    </div>
    <h1 class="text-xl font-black text-slate-800 mb-1">Déjà enregistrée</h1>
    <p class="text-slate-500 text-sm mb-5">
        Confirmée le <strong class="text-slate-700">{{ session.presenceConfirmeeAt|date('d/m/Y à H:i') }}</strong>
    </p>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 text-left mb-4">
        <div class="flex items-center gap-3 mb-2">
            <div class="w-10 h-10 bg-amber-200 rounded-xl flex items-center justify-center text-lg">📋</div>
            <div>
                <p class="font-bold text-slate-800 text-sm">Session #{{ session.id }} — {{ session.type }}</p>
                <p class="text-xs text-slate-500">{{ session.dateHeure|date('d/m/Y à H:i') }}</p>
            </div>
        </div>
    </div>

    <div class="bg-gradient-to-r from-amber-50 to-yellow-50 border border-amber-200 rounded-2xl p-4 flex items-center justify-between">
        <div class="text-left">
            <p class="text-xs text-amber-600 font-bold uppercase">Points attribués</p>
            <p class="text-2xl font-black text-amber-500">+{{ session.pointsPresence }} pts</p>
        </div>
        <span class="text-4xl">⭐</span>
    </div>

    <div class="mt-4 bg-slate-50 rounded-2xl p-3">
        <p class="text-xs text-slate-500">Total accumulé</p>
        <p class="text-xl font-black text-slate-700">{{ totalPoints }} pts</p>
        <p class="text-xs font-bold" style="color: {{ niveau.color }}">{{ niveau.emoji }} {{ niveau.name }}</p>
    </div>
</div>

{% else %}
{# ════════════════════════════════════════
   CONFIRMATION RÉUSSIE + GAMIFICATION
════════════════════════════════════════ #}
<div class="bg-white rounded-3xl shadow-2xl max-w-sm w-full overflow-hidden">

    {# ── Header vert succès ── #}
    <div class="relative bg-gradient-to-br from-emerald-500 to-teal-600 px-6 pt-8 pb-7 text-center overflow-hidden">
        <div class="absolute top-3 left-5 text-2xl opacity-30 pop-in delay-1">🎉</div>
        <div class="absolute top-5 right-6 text-xl opacity-30 pop-in delay-2">✨</div>
        <div class="absolute bottom-3 left-10 text-xl opacity-30 pop-in delay-3">⭐</div>
        <div class="absolute bottom-4 right-8 text-2xl opacity-30 pop-in delay-4">🎊</div>

        <div class="relative inline-block mb-4">
            <div class="pulse-ring"></div>
            <div class="w-20 h-20 bg-white/25 rounded-full flex items-center justify-center pop-in mx-auto">
                <i class="fas fa-check-circle text-white text-4xl"></i>
            </div>
        </div>

        <h1 class="text-2xl font-black text-white mb-1 slide-up delay-1">Présence confirmée !</h1>
        <p class="text-emerald-100 text-sm slide-up delay-2">Bienvenue à votre séance thérapeutique</p>
    </div>

    {# ── Badge nouveau débloqué ── #}
    {% if nouveauBadge %}
    <div class="mx-4 mt-4 bg-gradient-to-r from-purple-500 to-indigo-600 rounded-2xl p-4 text-white text-center pop-in shadow-lg">
        <p class="text-xs font-bold uppercase tracking-widest opacity-80 mb-1">🎖️ Nouveau Badge Débloqué !</p>
        <div class="text-4xl mb-1">{{ nouveauBadge.icon }}</div>
        <p class="font-black text-lg">{{ nouveauBadge.name }}</p>
        <p class="text-xs opacity-80">{{ nouveauBadge.desc }}</p>
    </div>
    {% endif %}

    {# ── Points gagnés ── #}
    <div class="px-5 py-4 bg-gradient-to-r from-amber-50 to-yellow-50 border-b border-amber-100 slide-up delay-2">
        <div class="flex items-center justify-between mb-3">
            <div>
                <p class="text-xs font-bold text-amber-600 uppercase tracking-wide">Points gagnés</p>
                <div class="flex items-baseline gap-1 mt-0.5">
                    <span class="text-5xl font-black shimmer-gold">+{{ pointsGagnes }}</span>
                    <span class="text-base font-bold text-amber-500">pts</span>
                </div>
            </div>
            <div class="w-16 h-16 bg-gradient-to-br from-amber-400 to-yellow-300 rounded-full flex items-center justify-center shadow-lg pop-in delay-3 text-3xl">
                ⭐
            </div>
        </div>

        {# Barre XP vers prochain niveau #}
        <div>
            <div class="flex justify-between text-xs text-amber-600 mb-1 font-medium">
                <span>{{ niveau.emoji }} {{ niveau.name }}</span>
                <span>{{ totalPoints }} / {{ niveau.nextMin }} XP</span>
            </div>
            <div class="h-3 bg-amber-100 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-amber-400 to-yellow-300 rounded-full xp-bar"
                     style="width: {{ niveau.progress }}%"></div>
            </div>
            {% if niveau.nextName %}
            <p class="text-xs text-amber-500 mt-1 text-right">Prochain : {{ niveau.nextName }}</p>
            {% endif %}
        </div>
    </div>

    {# ── Badges débloqués ── #}
    {% if badgesDebloques|length > 0 %}
    <div class="px-5 py-4 border-b border-slate-100 slide-up delay-3">
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-3">Badges obtenus</p>
        <div class="flex flex-wrap gap-2">
            {% for badge in badgesDebloques %}
            <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full text-white text-xs font-bold shadow-sm"
                 style="background-color: {{ badge.color }}">
                <span>{{ badge.icon }}</span>
                <span>{{ badge.name }}</span>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {# ── Prochain badge ── #}
    {% if prochainBadge %}
    <div class="px-5 py-3 bg-slate-50 border-b border-slate-100 slide-up delay-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span class="text-2xl opacity-40">{{ prochainBadge.icon }}</span>
                <div>
                    <p class="text-xs font-bold text-slate-500">Prochain badge</p>
                    <p class="text-sm font-bold text-slate-700">{{ prochainBadge.name }}</p>
                </div>
            </div>
            <div class="text-right">
                <p class="text-xs text-slate-400">Il manque</p>
                <p class="text-sm font-black text-indigo-600">{{ prochainBadge.manque }} pts</p>
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Détails session ── #}
    <div class="px-5 py-4 slide-up delay-4">
        <p class="text-xs font-bold text-slate-400 uppercase tracking-wide mb-3">Détails de la session</p>
        <div class="space-y-2 text-sm">
            <div class="flex justify-between">
                <span class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-calendar text-indigo-400 text-xs"></i> Date</span>
                <span class="font-bold text-slate-800">{{ session.dateHeure|date('d/m/Y') }}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-clock text-indigo-400 text-xs"></i> Heure</span>
                <span class="font-bold text-slate-800">{{ session.dateHeure|date('H:i') }}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-tag text-indigo-400 text-xs"></i> Type</span>
                <span class="font-bold text-slate-800">{{ session.type }}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-hourglass-half text-indigo-400 text-xs"></i> Durée</span>
                <span class="font-bold text-slate-800">{{ session.duree }} min</span>
            </div>
            <div class="flex justify-between border-t border-slate-100 pt-2">
                <span class="text-slate-500 flex items-center gap-1.5"><i class="fas fa-check text-emerald-400 text-xs"></i> Confirmé à</span>
                <span class="font-bold text-emerald-600">{{ session.presenceConfirmeeAt|date('H:i:s') }}</span>
            </div>
        </div>
    </div>

    {# ── Feedback Thérapeute ── #}
    {% if session.hasFeedback %}
    <div class="px-5 py-4 bg-blue-50 border-t border-blue-100 slide-up delay-5">
        <div class="flex items-start gap-3">
            <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center flex-shrink-0">
                <i class="fas fa-user-md text-white"></i>
            </div>
            <div class="flex-1">
                <p class="text-xs font-bold text-blue-600 uppercase tracking-wide mb-1">💬 Message du Thérapeute</p>
                <p class="text-sm text-slate-700 leading-relaxed bg-white rounded-lg p-3 shadow-sm">{{ session.feedbackTherapeute }}</p>
                <p class="text-xs text-blue-400 mt-2"><i class="fas fa-clock"></i> {{ session.feedbackAt|date('d/m/Y à H:i') }}</p>
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Footer ── #}
    <div class="px-5 pb-6 slide-up delay-5">
        <div class="bg-gradient-to-r from-indigo-50 to-purple-50 rounded-2xl p-4 text-center border border-indigo-100">
            <p class="text-sm font-bold text-indigo-700">
                <i class="fas fa-heart text-pink-400 mr-1"></i>
                Merci pour votre présence !
            </p>
            <p class="text-xs text-indigo-500 mt-1">{{ nbConfirmees }} session{{ nbConfirmees > 1 ? 's' : '' }} confirmée{{ nbConfirmees > 1 ? 's' : '' }} au total 🌟</p>
        </div>
    </div>

</div>

<script>
// Confettis
(function() {
    var colors = ['#10b981','#f59e0b','#6366f1','#ec4899','#3b82f6','#f97316'];
    var container = document.getElementById('confetti-container');
    for (var i = 0; i < 40; i++) {
        var el = document.createElement('div');
        el.className = 'confetti';
        el.style.left = Math.random() * 100 + 'vw';
        el.style.top  = '-10px';
        el.style.background = colors[Math.floor(Math.random() * colors.length)];
        el.style.width  = (Math.random() * 8 + 6) + 'px';
        el.style.height = (Math.random() * 8 + 6) + 'px';
        el.style.animationDuration  = (Math.random() * 2 + 1.5) + 's';
        el.style.animationDelay     = (Math.random() * 1) + 's';
        el.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
        container.appendChild(el);
    }
    setTimeout(function() { container.innerHTML = ''; }, 4000);
})();
</script>
{% endif %}

</body>
</html>
