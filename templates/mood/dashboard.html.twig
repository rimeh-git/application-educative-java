{% extends 'base.html.twig' %}

{% block title %}Suivi des Émotions{% endblock %}

{% block body %}
<style>
    .dashboard-container {
        padding: 30px;
        max-width: 1400px;
        margin: 0 auto;
    }
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }
    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        text-align: center;
    }
    .stat-card.happy {
        border-top: 5px solid #4CAF50;
    }
    .stat-card.neutral {
        border-top: 5px solid #FF9800;
    }
    .stat-card.sad {
        border-top: 5px solid #2196F3;
    }
    .stat-emoji {
        font-size: 4em;
        margin-bottom: 10px;
    }
    .stat-count {
        font-size: 3em;
        font-weight: bold;
        color: #333;
    }
    .stat-label {
        font-size: 1.2em;
        color: #666;
        margin-top: 10px;
    }
    .recent-moods {
        background: white;
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
    .recent-moods h2 {
        margin-bottom: 20px;
        color: #333;
    }
    .mood-list {
        display: grid;
        gap: 15px;
    }
    .mood-item {
        display: flex;
        align-items: center;
        padding: 15px;
        background: #f8f9fa;
        border-radius: 10px;
        border-left: 4px solid #ddd;
    }
    .mood-item.happy {
        border-left-color: #4CAF50;
    }
    .mood-item.neutral {
        border-left-color: #FF9800;
    }
    .mood-item.sad {
        border-left-color: #2196F3;
    }
    .mood-emoji-small {
        font-size: 2em;
        margin-right: 15px;
    }
    .mood-info {
        flex: 1;
    }
    .mood-patient {
        font-weight: bold;
        color: #333;
    }
    .mood-date {
        color: #666;
        font-size: 0.9em;
    }
    .action-buttons {
        display: flex;
        gap: 15px;
        margin-bottom: 30px;
    }
    .btn-action {
        padding: 12px 24px;
        border-radius: 10px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .btn-primary {
        background: #667eea;
        color: white;
    }
    .btn-primary:hover {
        background: #5568d3;
        transform: translateY(-2px);
    }
    .btn-secondary {
        background: #f1f5f9;
        color: #334155;
    }
    .btn-secondary:hover {
        background: #e2e8f0;
    }
</style>

<div class="dashboard-container">
    <h1 style="margin-bottom: 30px; color: #333;">📊 Suivi des Émotions</h1>
    
    <div class="action-buttons">
        <a href="{{ path('mood_qr_codes') }}" class="btn-action btn-primary">
            <i class="fas fa-qrcode"></i>
            Générer QR Codes
        </a>
        <a href="{{ path('mood_test') }}" class="btn-action btn-secondary">
            <i class="fas fa-flask"></i>
            Page de Test
        </a>
    </div>
    
    <div class="stats-grid">
        {% set happyCount = 0 %}
        {% set neutralCount = 0 %}
        {% set sadCount = 0 %}
        
        {% for stat in stats %}
            {% if stat.mood == 'happy' %}
                {% set happyCount = stat.count %}
            {% elseif stat.mood == 'neutral' %}
                {% set neutralCount = stat.count %}
            {% elseif stat.mood == 'sad' %}
                {% set sadCount = stat.count %}
            {% endif %}
        {% endfor %}
        
        <div class="stat-card happy">
            <div class="stat-emoji">😄</div>
            <div class="stat-count">{{ happyCount }}</div>
            <div class="stat-label">Heureux</div>
        </div>
        
        <div class="stat-card neutral">
            <div class="stat-emoji">😐</div>
            <div class="stat-count">{{ neutralCount }}</div>
            <div class="stat-label">Neutre</div>
        </div>
        
        <div class="stat-card sad">
            <div class="stat-emoji">😢</div>
            <div class="stat-count">{{ sadCount }}</div>
            <div class="stat-label">Triste</div>
        </div>
    </div>
    
    <div class="recent-moods">
        <h2>Derniers Enregistrements</h2>
        <div class="mood-list">
            {% if recentMoods is empty %}
                <p style="text-align: center; color: #999; padding: 40px;">
                    <i class="fas fa-inbox" style="font-size: 3em; margin-bottom: 15px; display: block;"></i>
                    Aucun enregistrement pour le moment
                </p>
            {% else %}
                {% for mood in recentMoods %}
                    <div class="mood-item {{ mood.mood }}">
                        <div class="mood-emoji-small">
                            {% if mood.mood == 'happy' %}😄
                            {% elseif mood.mood == 'neutral' %}😐
                            {% else %}😢
                            {% endif %}
                        </div>
                        <div class="mood-info">
                            <div class="mood-patient">{{ mood.patient.prenom }} {{ mood.patient.nom }}</div>
                            <div class="mood-date">{{ mood.createdAt|date('d/m/Y à H:i') }}</div>
                        </div>
                        <div style="color: #999;">
                            {% if mood.mood == 'happy' %}
                                <span style="color: #4CAF50; font-weight: 600;">Heureux</span>
                            {% elseif mood.mood == 'neutral' %}
                                <span style="color: #FF9800; font-weight: 600;">Neutre</span>
                            {% else %}
                                <span style="color: #2196F3; font-weight: 600;">Triste</span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
