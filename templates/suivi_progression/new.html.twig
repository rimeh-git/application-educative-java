{% extends 'base.html.twig' %}

{% block title %}Nouveau Suivi - TSA Thérapie{% endblock %}

{% block body %}
<div class="fade-in max-w-6xl mx-auto py-8 px-4">
    
    {# Header #}
    <div class="mb-8 text-center">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-400 to-emerald-600 shadow-lg mb-4">
            <i class="fas fa-plus-circle text-3xl text-white"></i>
        </div>
        <h1 class="text-3xl font-bold text-gray-900">Nouveau Suivi de Progression</h1>
        <p class="text-gray-500 mt-2">Créer un rapport d'évaluation thérapeutique</p>
    </div>

    {# Card Formulaire #}
    <div class="bg-gray-50 rounded-3xl shadow-xl border border-gray-200 overflow-hidden">
        <div class="p-8">
            {{ include('suivi_progression/_form.html.twig', {'button_label': '💾 Créer le suivi'}) }}
        </div>
    </div>

</div>
{% endblock %}