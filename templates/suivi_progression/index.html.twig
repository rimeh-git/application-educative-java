{% extends 'base.html.twig' %}

{% block title %}Suivis - TSA Thérapie{% endblock %}

{% block body %}
{% set suivis = suivis|default([]) %}

<div class="fade-in">
    
    {# Header #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                <span class="bg-gradient-to-br from-emerald-400 to-emerald-600 text-white p-3 rounded-2xl shadow-lg">
                    <i class="fas fa-chart-line text-2xl"></i>
                </span>
                Suivis de Progression
            </h1>
            <p class="text-gray-500 mt-2 ml-16">Rapports d'évaluation thérapeutique</p>
        </div>
        <a href="{{ path('app_suivi_progression_new') }}" 
           class="group bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white px-6 py-3 rounded-xl shadow-lg hover:shadow-xl transition-all flex items-center gap-2 transform hover:-translate-y-0.5">
            <i class="fas fa-plus transition-transform group-hover:rotate-90"></i>
            <span class="font-medium">Nouveau Suivi</span>
        </a>
    </div>

    {# Stats Cards #}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="bg-emerald-100 text-emerald-600 p-3 rounded-lg">
                <i class="fas fa-chart-bar text-xl"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">{{ suivis|length }}</p>
                <p class="text-sm text-gray-500">Total Suivis</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="bg-blue-100 text-blue-600 p-3 rounded-lg">
                <i class="fas fa-comments text-xl"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">{{ suivis|filter(s => s.domaine == 'COMMUNICATION')|length }}</p>
                <p class="text-sm text-gray-500">Communication</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="bg-purple-100 text-purple-600 p-3 rounded-lg">
                <i class="fas fa-users text-xl"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">{{ suivis|filter(s => s.domaine == 'SOCIALISATION')|length }}</p>
                <p class="text-sm text-gray-500">Socialisation</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex items-center gap-4 hover:shadow-md transition-shadow">
            <div class="bg-amber-100 text-amber-600 p-3 rounded-lg">
                <i class="fas fa-star text-xl"></i>
            </div>
            <div>
                {% set avgScore = suivis|length > 0 ? (suivis|reduce((acc, s) => acc + s.scoreApres, 0) / suivis|length) : 0 %}
                <p class="text-2xl font-bold text-gray-900">{{ avgScore|number_format(1) }}</p>
                <p class="text-sm text-gray-500">Score Moyen</p>
            </div>
        </div>
    </div>

    {# Table #}
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Session</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Domaine</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Avant</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Après</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Progression</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for suivi in suivis %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4">
                            <span class="font-mono text-sm font-semibold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full">#{{ suivi.id }}</span>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-col">
                                <span class="font-semibold text-gray-900">Session #{{ suivi.session.id }}</span>
                                <span class="text-sm text-gray-500">{{ suivi.session.dateHeure|date('d/m/Y H:i') }}</span>
                                <span class="text-xs text-gray-400">{{ suivi.session.duree }} min • {{ suivi.session.type }}</span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-700 border border-indigo-200">
                                {{ suivi.domaine }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-gray-100 text-gray-600 font-bold text-lg">
                                {{ suivi.scoreAvant }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex items-center justify-center w-10 h-10 rounded-lg bg-emerald-100 text-emerald-600 font-bold text-lg">
                                {{ suivi.scoreApres }}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center">
                            <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm font-bold {{ suivi.progression > 0 ? 'bg-emerald-100 text-emerald-700' : suivi.progression < 0 ? 'bg-rose-100 text-rose-700' : 'bg-gray-100 text-gray-700' }}">
                                {% if suivi.progression > 0 %}
                                    <i class="fas fa-arrow-up"></i> +{{ suivi.progression }}
                                {% elseif suivi.progression < 0 %}
                                    <i class="fas fa-arrow-down"></i> {{ suivi.progression }}
                                {% else %}
                                    <i class="fas fa-minus"></i> 0
                                {% endif %}
                            </span>
                        </td>
                        <td class="px-6 py-4 text-center text-sm text-gray-600">
                            {{ suivi.dateEvaluation|date('d/m/Y') }}
                        </td>
                        
                        {# ============ LES 3 BOUTONS CRUD (sans imprimer) ============ #}
                        <td class="px-6 py-4">
                            <div class="flex items-center justify-center gap-2">
                                
                                {# 1. BOUTON VOIR (Bleu) #}
                                <a href="{{ path('app_suivi_progression_show', {'id': suivi.id}) }}" 
                                   class="group relative flex items-center justify-center w-10 h-10 rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-500 hover:text-white transition-all duration-200 shadow-sm hover:shadow-md hover:scale-110" 
                                   title="Voir les détails">
                                    <i class="fas fa-eye text-sm"></i>
                                    <span class="absolute -bottom-10 left-1/2 -translate-x-1/2 px-3 py-1.5 bg-gray-800 text-white text-xs font-medium rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none shadow-lg">
                                        Voir
                                    </span>
                                </a>

                                {# 2. BOUTON MODIFIER (Amber) #}
                                <a href="{{ path('app_suivi_progression_edit', {'id': suivi.id}) }}" 
                                   class="group relative flex items-center justify-center w-10 h-10 rounded-xl bg-amber-50 text-amber-600 hover:bg-amber-500 hover:text-white transition-all duration-200 shadow-sm hover:shadow-md hover:scale-110" 
                                   title="Modifier le suivi">
                                    <i class="fas fa-edit text-sm"></i>
                                    <span class="absolute -bottom-10 left-1/2 -translate-x-1/2 px-3 py-1.5 bg-gray-800 text-white text-xs font-medium rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none shadow-lg">
                                        Modifier
                                    </span>
                                </a>

                                {# 3. BOUTON SUPPRIMER (Rouge) #}
                                <form method="post" action="{{ path('app_suivi_progression_delete', {'id': suivi.id}) }}" 
                                      class="inline" 
                                      onsubmit="return confirm('🗑️ Êtes-vous sûr de vouloir supprimer ce suivi ?\n\nCette action est irréversible.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ suivi.id) }}">
                                    <button type="submit" 
                                            class="group relative flex items-center justify-center w-10 h-10 rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-500 hover:text-white transition-all duration-200 shadow-sm hover:shadow-md hover:scale-110" 
                                            title="Supprimer le suivi">
                                        <i class="fas fa-trash-alt text-sm"></i>
                                        <span class="absolute -bottom-10 left-1/2 -translate-x-1/2 px-3 py-1.5 bg-gray-800 text-white text-xs font-medium rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none shadow-lg">
                                            Supprimer
                                        </span>
                                    </button>
                                </form>

                            </div>
                        </td>
                        {# ============ FIN DES 3 BOUTONS ============ #}
                        
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-16 text-center">
                            <div class="flex flex-col items-center text-gray-400">
                                <div class="bg-gray-100 p-6 rounded-full mb-4">
                                    <i class="fas fa-chart-bar text-5xl"></i>
                                </div>
                                <p class="text-xl font-medium mb-2">Aucun suivi trouvé</p>
                                <p class="text-sm mb-6">Créez votre premier rapport de suivi</p>
                                <a href="{{ path('app_suivi_progression_new') }}" 
                                   class="inline-flex items-center px-6 py-3 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 transition-colors shadow-lg">
                                    <i class="fas fa-plus mr-2"></i> 
                                    Créer un suivi
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}