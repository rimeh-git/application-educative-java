{% extends 'base.html.twig' %}
{% block title %}Dashboard — TSA Thérapie{% endblock %}

{% block body %}
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
:root {
  --indigo: #4f46e5; --violet: #7c3aed; --emerald: #059669;
  --amber: #d97706;  --rose: #e11d48;   --cyan: #0891b2;
  --ink: #0f172a;    --ink2: #334155;   --muted: #94a3b8;
  --border: #e2e8f0; --bg: #f8fafc;     --white: #ffffff;
}
* { box-sizing: border-box; font-family: 'Inter', sans-serif; }

@keyframes fadeUp { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }
.fade { animation: fadeUp .45s ease both; }
.d1{animation-delay:.05s} .d2{animation-delay:.12s} .d3{animation-delay:.19s}
.d4{animation-delay:.26s} .d5{animation-delay:.33s} .d6{animation-delay:.40s}

.page { padding: 28px 32px; background: var(--bg); min-height: 100vh; }

/* ── Header ── */
.page-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:28px; flex-wrap:wrap; gap:16px; }
.page-header h1 { font-size:26px; font-weight:900; color:var(--ink); letter-spacing:-.03em; margin:0; }
.page-header p  { font-size:13px; color:var(--muted); margin:4px 0 0; }
.btn { display:inline-flex; align-items:center; gap:8px; padding:10px 18px; border-radius:10px; font-size:13px; font-weight:700; text-decoration:none; border:none; cursor:pointer; transition:all .2s; }
.btn-primary { background:var(--indigo); color:#fff; }
.btn-primary:hover { background:#4338ca; transform:translateY(-1px); box-shadow:0 6px 20px rgba(79,70,229,.3); }
.btn-success { background:var(--emerald); color:#fff; }
.btn-success:hover { background:#047857; transform:translateY(-1px); }
.btn-outline { background:#fff; color:var(--ink2); border:1.5px solid var(--border); }
.btn-outline:hover { border-color:var(--indigo); color:var(--indigo); }

/* ── KPI Grid ── */
.kpi-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:24px; }
.kpi { background:var(--white); border-radius:18px; padding:22px; border:1px solid var(--border); position:relative; overflow:hidden; transition:transform .2s,box-shadow .2s; }
.kpi:hover { transform:translateY(-3px); box-shadow:0 16px 40px rgba(0,0,0,.07); }
.kpi-glow { position:absolute; top:-40px; right:-40px; width:110px; height:110px; border-radius:50%; opacity:.1; pointer-events:none; }
.kpi-top { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px; }
.kpi-icon { width:44px; height:44px; border-radius:13px; display:flex; align-items:center; justify-content:center; font-size:18px; }
.kpi-badge { font-size:11px; font-weight:700; padding:3px 10px; border-radius:20px; }
.kpi-val { font-size:36px; font-weight:900; line-height:1; letter-spacing:-.04em; margin-bottom:4px; }
.kpi-label { font-size:11px; color:var(--muted); font-weight:700; text-transform:uppercase; letter-spacing:.06em; margin-bottom:12px; }
.kpi-foot { font-size:12px; color:var(--muted); padding-top:12px; border-top:1px solid var(--border); }
.kpi-foot strong { color:var(--emerald); }

/* ── Cards ── */
.card { background:var(--white); border-radius:18px; padding:24px; border:1px solid var(--border); }
.card-hdr { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
.card-title { font-size:15px; font-weight:800; color:var(--ink); }
.card-sub { font-size:12px; color:var(--muted); margin-top:2px; }
.chip { font-size:11px; font-weight:700; padding:4px 10px; border-radius:20px; background:var(--bg); color:var(--ink2); border:1px solid var(--border); }

/* ── Grid layouts ── */
.grid-2 { display:grid; grid-template-columns:3fr 2fr; gap:20px; margin-bottom:24px; }
.grid-3 { display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-bottom:24px; }

/* ── Table ── */
.tbl-wrap { overflow-x:auto; }
table { width:100%; border-collapse:collapse; }
thead th { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); padding:0 16px 12px; text-align:left; border-bottom:2px solid var(--border); }
tbody td { padding:13px 16px; font-size:13px; color:var(--ink2); border-bottom:1px solid var(--border); }
tbody tr:last-child td { border-bottom:none; }
tbody tr:hover td { background:#f8faff; }
.avatar { width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:800; color:#fff; flex-shrink:0; }
.badge { display:inline-flex; align-items:center; gap:5px; padding:4px 10px; border-radius:20px; font-size:11px; font-weight:700; }
.badge-dot { width:5px; height:5px; border-radius:50%; }

/* ── Progress ── */
.prog-item { margin-bottom:16px; }
.prog-item:last-child { margin-bottom:0; }
.prog-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:7px; }
.prog-name { font-size:13px; font-weight:600; color:var(--ink2); display:flex; align-items:center; gap:8px; }
.prog-icon { width:26px; height:26px; border-radius:7px; display:flex; align-items:center; justify-content:center; font-size:11px; }
.prog-val { font-size:18px; font-weight:900; }
.prog-bar { height:7px; background:var(--bg); border-radius:99px; overflow:hidden; border:1px solid var(--border); }
.prog-fill { height:100%; border-radius:99px; transition:width 1.2s cubic-bezier(.4,0,.2,1); }

/* ── Session card ── */
.sess-card { display:flex; align-items:center; gap:12px; padding:12px; border-radius:12px; background:var(--bg); border:1px solid var(--border); margin-bottom:8px; transition:all .2s; text-decoration:none; }
.sess-card:last-child { margin-bottom:0; }
.sess-card:hover { background:#eef2ff; border-color:rgba(79,70,229,.2); transform:translateX(3px); }
.sess-time { font-size:11px; font-weight:700; color:var(--muted); min-width:50px; }
.sess-info { flex:1; }
.sess-type { font-size:13px; font-weight:800; color:var(--ink); }
.sess-date { font-size:11px; color:var(--muted); margin-top:1px; }

/* ── Risk gauge ── */
.risk-gauge { text-align:center; padding:16px 0; }
.risk-gauge .score { font-size:42px; font-weight:900; line-height:1; }
.risk-gauge .label { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; margin-top:4px; }

/* ── Quick links ── */
.qlink { display:flex; align-items:center; gap:12px; padding:12px 14px; border-radius:12px; text-decoration:none; border:1.5px solid var(--border); background:var(--white); transition:all .2s; margin-bottom:8px; }
.qlink:last-child { margin-bottom:0; }
.qlink:hover { border-color:var(--indigo); transform:translateX(4px); box-shadow:0 4px 16px rgba(79,70,229,.1); }
.qlink-icon { width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:14px; flex-shrink:0; }
.qlink-label { font-size:13px; font-weight:700; color:var(--ink); }

/* ── Suivi item ── */
.suivi-item { display:flex; align-items:center; gap:12px; padding:10px 0; border-bottom:1px solid var(--border); }
.suivi-item:last-child { border-bottom:none; }
.suivi-score { width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:14px; font-weight:900; flex-shrink:0; }

@media(max-width:1100px) { .kpi-grid{grid-template-columns:repeat(2,1fr)} .grid-2{grid-template-columns:1fr} .grid-3{grid-template-columns:1fr} }
@media(max-width:640px)  { .kpi-grid{grid-template-columns:1fr} }
</style>

{% set totalS = stats.totalSessions ?? 0 %}
{% set totalV = stats.totalSuivis ?? 0 %}
{% set planif = stats.sessionsPlanifiees ?? 0 %}
{% set term   = stats.sessionsTerminees ?? 0 %}

<div class="page">

  {# ── Header ── #}
  <div class="page-header fade d1">
    <div>
      <h1>🏥 Espace Famille</h1>
      <p>{{ "now"|date("l d/m/Y") }} — Bienvenue sur votre tableau de bord</p>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <a href="{{ path('app_session_new') }}" class="btn btn-success">
        <i class="fas fa-plus"></i> Nouvelle Session
      </a>
      <a href="{{ path('app_suivi_progression_new') }}" class="btn btn-primary">
        <i class="fas fa-chart-line"></i> Nouveau Suivi
      </a>
    </div>
  </div>

  {# ── KPIs ── #}
  <div class="kpi-grid fade d2">

    <div class="kpi">
      <div class="kpi-glow" style="background:var(--indigo)"></div>
      <div class="kpi-top">
        <div class="kpi-icon" style="background:#eef0ff;color:var(--indigo)"><i class="fas fa-calendar-check"></i></div>
        <span class="kpi-badge" style="background:#eef0ff;color:var(--indigo)">Total</span>
      </div>
      <div class="kpi-val" style="color:var(--indigo)">{{ totalS }}</div>
      <div class="kpi-label">Sessions</div>
      <div class="kpi-foot">
        <strong>{{ term }}</strong> terminées · {{ planif }} planifiées
      </div>
    </div>

    <div class="kpi">
      <div class="kpi-glow" style="background:var(--emerald)"></div>
      <div class="kpi-top">
        <div class="kpi-icon" style="background:#d1fae5;color:var(--emerald)"><i class="fas fa-chart-line"></i></div>
        <span class="kpi-badge" style="background:#d1fae5;color:var(--emerald)">Suivi</span>
      </div>
      <div class="kpi-val" style="color:var(--emerald)">{{ totalV }}</div>
      <div class="kpi-label">Progressions</div>
      <div class="kpi-foot">Évaluations enregistrées</div>
    </div>

    <div class="kpi">
      <div class="kpi-glow" style="background:var(--amber)"></div>
      <div class="kpi-top">
        <div class="kpi-icon" style="background:#fef3c7;color:var(--amber)"><i class="fas fa-clock"></i></div>
        <span class="kpi-badge" style="background:#fef3c7;color:var(--amber)">En attente</span>
      </div>
      <div class="kpi-val" style="color:var(--amber)">{{ planif }}</div>
      <div class="kpi-label">Planifiées</div>
      <div class="kpi-foot">Sessions à venir</div>
    </div>

    <div class="kpi">
      <div class="kpi-glow" style="background:var(--violet)"></div>
      <div class="kpi-top">
        <div class="kpi-icon" style="background:#f3e8ff;color:var(--violet)"><i class="fas fa-check-double"></i></div>
        <span class="kpi-badge" style="background:#f3e8ff;color:var(--violet)">Terminées</span>
      </div>
      <div class="kpi-val" style="color:var(--violet)">{{ term }}</div>
      <div class="kpi-label">Complétées</div>
      <div class="kpi-foot">Sessions réalisées</div>
    </div>

  </div>

  {# ── Row 1 : Chart + Prochaines sessions ── #}
  <div class="grid-2 fade d3">

    {# Évolution #}
    <div class="card">
      <div class="card-hdr">
        <div>
          <div class="card-title">Évolution des sessions</div>
          <div class="card-sub">Sessions & suivis sur 6 mois</div>
        </div>
        <span class="chip"><i class="fas fa-chart-bar"></i> 6 mois</span>
      </div>
      <canvas id="barChart" height="130"></canvas>
    </div>

    {# Prochaines sessions #}
    <div class="card">
      <div class="card-hdr">
        <div>
          <div class="card-title">Prochaines Sessions</div>
          <div class="card-sub">Sessions à venir</div>
        </div>
        <a href="{{ path('app_session_index') }}" class="chip" style="text-decoration:none">Voir tout →</a>
      </div>
      {% if prochaines is not empty %}
        {% for s in prochaines %}
        {% set typeColors = {'ABA':'#4f46e5','PECS':'#7c3aed','Orthophonie':'#0d9488'} %}
        {% set tc = typeColors[s.type] ?? '#64748b' %}
        <a href="{{ path('app_session_show', {id: s.id}) }}" class="sess-card">
          <div class="sess-time">{{ s.dateHeure|date('H:i') }}</div>
          <div style="width:8px;height:8px;border-radius:50%;background:{{ tc }};flex-shrink:0"></div>
          <div class="sess-info">
            <div class="sess-type">{{ s.type }}</div>
            <div class="sess-date">{{ s.dateHeure|date('d/m/Y') }} · {{ s.duree }} min</div>
          </div>
          <span style="font-size:11px;font-weight:700;padding:3px 8px;border-radius:20px;background:#eef0ff;color:#4f46e5">
            {{ s.statut|replace({'_':' '}) }}
          </span>
        </a>
        {% endfor %}
      {% else %}
        <div style="text-align:center;padding:32px;color:var(--muted)">
          <i class="fas fa-calendar-times" style="font-size:32px;opacity:.3;display:block;margin-bottom:10px"></i>
          <p style="font-size:13px">Aucune session à venir</p>
          <a href="{{ path('app_session_new') }}" class="btn btn-primary" style="margin-top:12px;display:inline-flex;font-size:12px">
            <i class="fas fa-plus"></i> Créer une session
          </a>
        </div>
      {% endif %}
    </div>

  </div>

  {# ── Row 2 : Sessions récentes + Suivis récents + Risque ── #}
  <div class="grid-3 fade d4">

    {# Sessions récentes #}
    <div class="card">
      <div class="card-hdr">
        <div>
          <div class="card-title">Sessions récentes</div>
          <div class="card-sub">Dernières séances</div>
        </div>
        <a href="{{ path('app_session_index') }}" class="btn btn-outline" style="padding:6px 12px;font-size:11px">Voir tout</a>
      </div>
      <div class="tbl-wrap">
        {% if sessionsRecentes is not empty %}
        <table>
          <thead>
            <tr>
              <th>Session</th>
              <th>Statut</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            {% for s in sessionsRecentes %}
            {% set typeColors = {'ABA':{bg:'#eef0ff',text:'#4f46e5'},'PECS':{bg:'#f3e8ff',text:'#7c3aed'},'Orthophonie':{bg:'#ccfbf1',text:'#0d9488'}} %}
            {% set tc = typeColors[s.type] ?? {bg:'#f1f5f9',text:'#64748b'} %}
            {% set statColors = {'PLANIFIEE':{bg:'#dbeafe',text:'#1d4ed8'},'TERMINEE':{bg:'#d1fae5',text:'#065f46'},'ANNULEE':{bg:'#ffe4e6',text:'#9f1239'},'EN_COURS':{bg:'#fef3c7',text:'#92400e'}} %}
            {% set sc = statColors[s.statut] ?? {bg:'#f1f5f9',text:'#64748b'} %}
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:8px">
                  <div class="avatar" style="background:{{ tc.text }};width:30px;height:30px;font-size:11px">{{ s.type|first }}</div>
                  <div>
                    <div style="font-weight:700;font-size:12px;color:var(--ink)">#{{ s.id }} {{ s.type }}</div>
                    <div style="font-size:11px;color:var(--muted)">{{ s.dateHeure|date('d/m/Y') }}</div>
                  </div>
                </div>
              </td>
              <td><span class="badge" style="background:{{ sc.bg }};color:{{ sc.text }}">{{ s.statut|replace({'_':' '}) }}</span></td>
              <td><a href="{{ path('app_session_show', {id: s.id}) }}" style="color:var(--indigo);font-size:12px"><i class="fas fa-eye"></i></a></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <div style="text-align:center;padding:24px;color:var(--muted);font-size:13px">Aucune session</div>
        {% endif %}
      </div>
    </div>

    {# Suivis récents #}
    <div class="card">
      <div class="card-hdr">
        <div>
          <div class="card-title">Suivis récents</div>
          <div class="card-sub">Dernières progressions</div>
        </div>
        <a href="{{ path('app_suivi_progression_index') }}" class="btn btn-outline" style="padding:6px 12px;font-size:11px">Voir tout</a>
      </div>
      {% if suivisRecents is not empty %}
        {% for sv in suivisRecents %}
        {% set prog = sv.progression ?? 0 %}
        {% set progColor = prog > 0 ? '#059669' : (prog < 0 ? '#e11d48' : '#94a3b8') %}
        {% set progBg    = prog > 0 ? '#d1fae5' : (prog < 0 ? '#ffe4e6' : '#f1f5f9') %}
        <div class="suivi-item">
          <div class="suivi-score" style="background:{{ progBg }};color:{{ progColor }}">
            {{ prog > 0 ? '+' : '' }}{{ prog }}
          </div>
          <div style="flex:1">
            <div style="font-size:13px;font-weight:700;color:var(--ink)">{{ sv.domaine }}</div>
            <div style="font-size:11px;color:var(--muted)">
              {{ sv.scoreAvant }}/10 → {{ sv.scoreApres }}/10 · {{ sv.dateEvaluation|date('d/m/Y') }}
            </div>
          </div>
          <a href="{{ path('app_suivi_progression_show', {id: sv.id}) }}" style="color:var(--indigo);font-size:12px"><i class="fas fa-eye"></i></a>
        </div>
        {% endfor %}
      {% else %}
        <div style="text-align:center;padding:32px;color:var(--muted)">
          <i class="fas fa-chart-line" style="font-size:32px;opacity:.3;display:block;margin-bottom:10px"></i>
          <p style="font-size:13px">Aucun suivi enregistré</p>
          <a href="{{ path('app_suivi_progression_new') }}" class="btn btn-primary" style="margin-top:12px;display:inline-flex;font-size:12px">
            <i class="fas fa-plus"></i> Ajouter un suivi
          </a>
        </div>
      {% endif %}
    </div>

    {# Risque + Accès rapides ── #}
    <div style="display:flex;flex-direction:column;gap:20px">

      {# Risque abandon #}
      <div class="card">
        <div class="card-hdr">
          <div>
            <div class="card-title">Risque d'abandon</div>
            <div class="card-sub">Analyse globale</div>
          </div>
        </div>
        {% if riskAssessments is not empty and riskAssessments.score is defined %}
          {% set rs = riskAssessments.score %}
          {% set rc = rs >= 75 ? '#dc2626' : (rs >= 50 ? '#d97706' : (rs >= 25 ? '#ca8a04' : '#059669')) %}
          {% set rb = rs >= 75 ? '#fee2e2' : (rs >= 50 ? '#fef3c7' : (rs >= 25 ? '#fef9c3' : '#d1fae5')) %}
          <div style="background:{{ rb }};border-radius:12px;padding:16px;text-align:center;margin-bottom:12px">
            <div style="font-size:40px;font-weight:900;color:{{ rc }};line-height:1">{{ rs }}%</div>
            <div style="font-size:12px;font-weight:700;color:{{ rc }};text-transform:uppercase;letter-spacing:.06em;margin-top:4px">
              {{ riskAssessments.niveau }}
            </div>
          </div>
          {% for rec in riskAssessments.recommandations|slice(0,2) %}
          <div style="font-size:11px;color:var(--ink2);padding:7px 10px;background:var(--bg);border-radius:8px;margin-bottom:6px">{{ rec }}</div>
          {% endfor %}
        {% else %}
          <div style="text-align:center;padding:20px;color:var(--muted)">
            <i class="fas fa-smile" style="font-size:28px;opacity:.3;display:block;margin-bottom:8px"></i>
            <p style="font-size:12px">Aucun risque détecté</p>
          </div>
        {% endif %}
      </div>

      {# Accès rapides #}
      <div class="card">
        <div class="card-hdr">
          <div class="card-title">Accès rapides</div>
        </div>
        {% set links = [
          {label:'Sessions',      icon:'fa-calendar-alt', route:'app_session_index',          bg:'#eef0ff', color:'#4f46e5'},
          {label:'Progressions',  icon:'fa-chart-line',   route:'app_suivi_progression_index', bg:'#d1fae5', color:'#059669'},
          {label:'Nouvelle session', icon:'fa-plus',      route:'app_session_new',             bg:'#fef3c7', color:'#d97706'},
          {label:'Nouveau suivi', icon:'fa-edit',         route:'app_suivi_progression_new',   bg:'#f3e8ff', color:'#7c3aed'},
        ] %}
        {% for lnk in links %}
        <a href="{{ path(lnk.route) }}" class="qlink">
          <div class="qlink-icon" style="background:{{ lnk.bg }};color:{{ lnk.color }}">
            <i class="fas {{ lnk.icon }}"></i>
          </div>
          <span class="qlink-label">{{ lnk.label }}</span>
          <i class="fas fa-chevron-right" style="margin-left:auto;font-size:10px;color:var(--muted)"></i>
        </a>
        {% endfor %}
      </div>

    </div>

  </div>

</div>

<script>
const C = { muted:'#94a3b8', border:'#e2e8f0', ink2:'#334155' };
const f = { family:'Inter' };

new Chart(document.getElementById('barChart'), {
  type: 'bar',
  data: {
    labels: ['Nov','Déc','Jan','Fév','Mar','Avr'],
    datasets: [
      { label:'Sessions', data:[3,5,4,7,6,{{ totalS }}], backgroundColor:'rgba(79,70,229,.15)', borderColor:'#4f46e5', borderWidth:2, borderRadius:8, borderSkipped:false },
      { label:'Suivis',   data:[2,3,3,5,4,{{ totalV }}], backgroundColor:'rgba(5,150,105,.12)',  borderColor:'#059669', borderWidth:2, borderRadius:8, borderSkipped:false }
    ]
  },
  options: {
    responsive:true,
    plugins:{ legend:{ labels:{ font:{...f,weight:'700',size:12}, color:C.ink2, usePointStyle:true, pointStyleWidth:8 } } },
    scales:{
      x:{ grid:{display:false}, ticks:{font:f,color:C.muted} },
      y:{ grid:{color:C.border}, ticks:{font:f,color:C.muted} }
    }
  }
});
</script>
{% endblock %}
