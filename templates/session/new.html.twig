{% extends 'base.html.twig' %}
{% block title %}Nouvelle Session — TSA Thérapie{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto fade-in">

    {# Breadcrumb #}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{{ path('app_session_index') }}" class="hover:text-indigo-600 flex items-center gap-1 transition-colors">
            <i class="fas fa-home"></i> Accueil
        </a>
        <i class="fas fa-chevron-right text-xs text-gray-400"></i>
        <a href="{{ path('app_session_index') }}" class="hover:text-indigo-600 transition-colors">Sessions</a>
        <i class="fas fa-chevron-right text-xs text-gray-400"></i>
        <span class="text-gray-900 font-semibold">Nouvelle Session</span>
    </nav>

    {% for type, messages in app.flashes %}{% for message in messages %}
        <div class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium mb-4
            {{ type == 'success' ? 'bg-emerald-50 border border-emerald-200 text-emerald-800' :
               type == 'error'   ? 'bg-rose-50 border border-rose-200 text-rose-800' :
               'bg-blue-50 border border-blue-200 text-blue-800' }}">
            <i class="fas {{ type == 'success' ? 'fa-check-circle text-emerald-500' : 'fa-info-circle text-blue-500' }}"></i>
            {{ message }}
        </div>
    {% endfor %}{% endfor %}

    <div class="grid grid-cols-1 gap-6">

        <div>
            <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden">

                {# Header gradient #}
                <div class="relative bg-gradient-to-r from-indigo-600 via-violet-600 to-purple-600 px-8 py-8 text-white overflow-hidden">
                    <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
                    <div class="absolute bottom-0 left-0 -mb-4 -ml-4 w-24 h-24 bg-white/10 rounded-full blur-xl"></div>
                    <div class="relative z-10 flex items-center gap-4">
                        <div class="bg-white/20 backdrop-blur-sm p-3 rounded-2xl">
                            <i class="fas fa-calendar-plus text-2xl"></i>
                        </div>
                        <div>
                            <h1 class="text-3xl font-bold">Nouvelle Session</h1>
                            <p class="text-indigo-200 mt-1">Créez une nouvelle séance thérapeutique</p>
                        </div>
                    </div>
                </div>

                {{ form_start(form, {'attr': {'id': 'session-form', 'class': 'p-8 lg:p-10 space-y-8', 'novalidate': 'novalidate'}}) }}

                {# Section 1 : Planification #}
                <div class="bg-indigo-50/50 rounded-2xl p-6 border border-indigo-100">
                    <h3 class="text-lg font-bold text-indigo-800 mb-6 flex items-center gap-2">
                        <span class="bg-indigo-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">1</span>
                        📅 Planification
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.dateHeure) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-calendar-alt text-indigo-400 text-lg"></i>
                                </div>
                                {{ form_widget(form.dateHeure, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition-all outline-none text-gray-700'}}) }}
                            </div>
                            {{ form_errors(form.dateHeure) }}
                        </div>
                        <div>
                            {{ form_label(form.duree) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-hourglass-half text-indigo-400 text-lg"></i>
                                </div>
                                {{ form_widget(form.duree, {'attr': {'class': 'w-full pl-12 pr-16 py-3 rounded-xl border-2 border-gray-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition-all outline-none text-gray-700'}}) }}
                                <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                    <span class="text-gray-400 font-medium">min</span>
                                </div>
                            </div>
                            {{ form_errors(form.duree) }}
                        </div>
                    </div>
                </div>

                {# Section 2 : Type & Statut #}
                <div class="bg-violet-50/50 rounded-2xl p-6 border border-violet-100">
                    <h3 class="text-lg font-bold text-violet-800 mb-6 flex items-center gap-2">
                        <span class="bg-violet-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">2</span>
                        🎯 Type et Statut
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.type) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-hand-holding-heart text-violet-400 text-lg"></i>
                                </div>
                                {{ form_widget(form.type, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-violet-500 focus:ring-4 focus:ring-violet-100 transition-all outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                                <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                    <i class="fas fa-chevron-down text-violet-400"></i>
                                </div>
                            </div>
                            {{ form_errors(form.type) }}
                        </div>
                        <div>
                            {{ form_label(form.statut) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-tasks text-violet-400 text-lg"></i>
                                </div>
                                {{ form_widget(form.statut, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-violet-500 focus:ring-4 focus:ring-violet-100 transition-all outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                                <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                    <i class="fas fa-chevron-down text-violet-400"></i>
                                </div>
                            </div>
                            {{ form_errors(form.statut) }}
                        </div>
                    </div>
                </div>

                {# Section 3 : Comportement #}
                <div class="bg-rose-50/50 rounded-2xl p-6 border border-rose-100">
                    <h3 class="text-lg font-bold text-rose-800 mb-6 flex items-center gap-2">
                        <span class="bg-rose-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">3</span>
                        😊 Évaluation comportementale
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.niveauAgitation) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-heart-pulse text-rose-400 text-lg"></i>
                                </div>
                                {{ form_widget(form.niveauAgitation, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-rose-500 focus:ring-4 focus:ring-rose-100 transition-all outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                                <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                    <i class="fas fa-chevron-down text-rose-400"></i>
                                </div>
                            </div>
                            {{ form_errors(form.niveauAgitation) }}
                        </div>
                        <div>
                            {{ form_label(form.techniqueUtilisee) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-tools text-rose-400 text-lg"></i>
                                </div>
                                {{ form_widget(form.techniqueUtilisee, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-rose-500 focus:ring-4 focus:ring-rose-100 transition-all outline-none text-gray-700'}}) }}
                            </div>
                            {{ form_errors(form.techniqueUtilisee) }}
                        </div>
                    </div>
                </div>

                {# Section 4 : Objectifs & Notes #}
                <div class="bg-amber-50/50 rounded-2xl p-6 border border-amber-100">
                    <h3 class="text-lg font-bold text-amber-800 mb-6 flex items-center gap-2">
                        <span class="bg-amber-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">4</span>
                        📝 Objectifs et Observations
                    </h3>
                    <div class="space-y-6">
                        <div>
                            {{ form_label(form.objectifSeance) }}
                            <div class="relative mt-2">
                                <div class="absolute top-4 left-4 pointer-events-none">
                                    <i class="fas fa-bullseye text-amber-500 text-lg"></i>
                                </div>
                                {{ form_widget(form.objectifSeance, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-amber-500 focus:ring-4 focus:ring-amber-100 transition-all outline-none text-gray-700 resize-none'}}) }}
                            </div>
                            {{ form_errors(form.objectifSeance) }}
                        </div>
                        <div>
                            {{ form_label(form.notes) }}
                            <div class="relative mt-2">
                                <div class="absolute top-4 left-4 pointer-events-none">
                                    <i class="fas fa-clipboard text-amber-500 text-lg"></i>
                                </div>
                                {{ form_widget(form.notes, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-amber-500 focus:ring-4 focus:ring-amber-100 transition-all outline-none text-gray-700 resize-none'}}) }}
                            </div>
                            {{ form_errors(form.notes) }}
                        </div>
                    </div>
                </div>

                {# Section 5 : Contact #}
                <div class="bg-emerald-50/50 rounded-2xl p-6 border border-emerald-100">
                    <h3 class="text-lg font-bold text-emerald-800 mb-6 flex items-center gap-2">
                        <span class="bg-emerald-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">5</span>
                        👤 Responsable / Parent
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            {{ form_label(form.nomResponsable) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-user text-emerald-400"></i>
                                </div>
                                {{ form_widget(form.nomResponsable, {'attr': {'class': 'w-full pl-10 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-gray-700'}}) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.telephoneResponsable) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-phone text-emerald-400"></i>
                                </div>
                                {{ form_widget(form.telephoneResponsable, {'attr': {'class': 'w-full pl-10 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-gray-700'}}) }}
                            </div>
                        </div>
                        <div>
                            {{ form_label(form.parentEmail) }}
                            <div class="relative mt-2">
                                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                    <i class="fas fa-envelope text-emerald-400"></i>
                                </div>
                                {{ form_widget(form.parentEmail, {'attr': {'class': 'w-full pl-10 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100 transition-all outline-none text-gray-700'}}) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# Boutons #}
                <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-6 border-t-2 border-gray-100">
                    <a href="{{ path('app_session_index') }}"
                       class="px-8 py-4 rounded-xl border-2 border-gray-200 text-gray-600 font-semibold hover:bg-gray-50 transition-all flex items-center gap-2">
                        <i class="fas fa-times"></i> Annuler
                    </a>
                    <button type="submit"
                        class="px-10 py-4 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1 flex items-center gap-3 text-lg">
                        <i class="fas fa-save"></i> Créer la session
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>

    </div>
</div>

<style>
    input[type="datetime-local"] { color-scheme: light; }
</style>
{% endblock %}
