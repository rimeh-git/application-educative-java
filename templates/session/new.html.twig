{% extends 'base.html.twig' %}

{% block title %}Nouvelle Session - TSA Thérapie{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto fade-in">
    {# Breadcrumb #}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{{ path('app_session_index') }}" class="hover:text-indigo-600 flex items-center gap-1 transition-colors">
            <i class="fas fa-home"></i> Accueil
        </a>
        <i class="fas fa-chevron-right text-xs text-gray-400"></i>
        <a href="{{ path('app_session_index') }}" class="hover:text-indigo-600 transition-colors">Sessions</a>
        <i class="fas fa-chevron-right text-xs text-gray-400"></i>
        <span class="text-gray-900 font-semibold">Nouvelle Session</span>
    </nav>

    {# Main Card #}
    <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden">
        {# Header avec gradient #}
        <div class="relative bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 px-8 py-8 text-white overflow-hidden">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
            <div class="absolute bottom-0 left-0 -mb-4 -ml-4 w-24 h-24 bg-white/10 rounded-full blur-xl"></div>
            
            <div class="relative z-10">
                <div class="flex items-center gap-4 mb-2">
                    <div class="bg-white/20 backdrop-blur-sm p-3 rounded-2xl">
                        <i class="fas fa-calendar-plus text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold">Nouvelle Session Thérapeutique</h1>
                        <p class="text-indigo-100 mt-1">Planifiez et organisez une nouvelle séance</p>
                    </div>
                </div>
            </div>
        </div>

        {# Formulaire #}
        <div class="p-8 lg:p-10">
            {{ form_start(form, {'attr': {'class': 'space-y-8', 'novalidate': 'novalidate'}}) }}
            
            {# Section 1: Informations de base #}
            <div class="bg-indigo-50/50 rounded-2xl p-6 border border-indigo-100">
                <h3 class="text-lg font-bold text-indigo-800 mb-6 flex items-center gap-2">
                    <span class="bg-indigo-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">1</span>
                    📋 Informations de base
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {# Date et Heure #}
                    <div class="form-group">
                        {{ form_label(form.dateHeure) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-calendar-alt text-indigo-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.dateHeure, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition-all duration-200 outline-none text-gray-700'}}) }}
                        </div>
                        {{ form_errors(form.dateHeure, {'attr': {'class': 'text-rose-500 text-sm mt-2 flex items-center gap-1'}}) }}
                    </div>

                    {# Durée #}
                    <div class="form-group">
                        {{ form_label(form.duree) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-hourglass-half text-indigo-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.duree, {'attr': {'class': 'w-full pl-12 pr-20 py-3 rounded-xl border-2 border-gray-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition-all duration-200 outline-none text-gray-700'}}) }}
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <span class="text-gray-400 font-medium">min</span>
                            </div>
                        </div>
                        {{ form_errors(form.duree) }}
                    </div>
                </div>
            </div>

            {# Section 2: Type et Statut #}
            <div class="bg-purple-50/50 rounded-2xl p-6 border border-purple-100">
                <h3 class="text-lg font-bold text-purple-800 mb-6 flex items-center gap-2">
                    <span class="bg-purple-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">2</span>
                    🎯 Type et Statut
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {# Type #}
                    <div class="form-group">
                        {{ form_label(form.type) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-hand-holding-heart text-purple-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.type, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-purple-500 focus:ring-4 focus:ring-purple-100 transition-all duration-200 outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-purple-400"></i>
                            </div>
                        </div>
                        {{ form_errors(form.type) }}
                    </div>

                    {# Statut #}
                    <div class="form-group">
                        {{ form_label(form.statut) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-tasks text-purple-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.statut, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-purple-500 focus:ring-4 focus:ring-purple-100 transition-all duration-200 outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-purple-400"></i>
                            </div>
                        </div>
                        {{ form_errors(form.statut) }}
                    </div>
                </div>
            </div>

            {# Section 3: Évaluation comportementale #}
            <div class="bg-pink-50/50 rounded-2xl p-6 border border-pink-100">
                <h3 class="text-lg font-bold text-pink-800 mb-6 flex items-center gap-2">
                    <span class="bg-pink-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">3</span>
                    😊 Évaluation comportementale
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {# Niveau d'agitation #}
                    <div class="form-group">
                        {{ form_label(form.niveauAgitation) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-heart-pulse text-pink-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.niveauAgitation, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-pink-500 focus:ring-4 focus:ring-pink-100 transition-all duration-200 outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-pink-400"></i>
                            </div>
                        </div>
                        {{ form_errors(form.niveauAgitation) }}
                    </div>

                    {# Technique utilisée #}
                    <div class="form-group">
                        {{ form_label(form.techniqueUtilisee) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-tools text-pink-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.techniqueUtilisee, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-pink-500 focus:ring-4 focus:ring-pink-100 transition-all duration-200 outline-none text-gray-700'}}) }}
                        </div>
                        {{ form_errors(form.techniqueUtilisee) }}
                    </div>
                </div>
            </div>

            {# Section 4: Objectifs et Notes #}
            <div class="bg-amber-50/50 rounded-2xl p-6 border border-amber-100">
                <h3 class="text-lg font-bold text-amber-800 mb-6 flex items-center gap-2">
                    <span class="bg-amber-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">4</span>
                    📝 Objectifs et Observations
                </h3>
                
                <div class="space-y-6">
                    {# Objectif #}
                    <div class="form-group">
                        {{ form_label(form.objectifSeance) }}
                        <div class="relative mt-2">
                            <div class="absolute top-4 left-4 flex items-center pointer-events-none">
                                <i class="fas fa-bullseye text-amber-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.objectifSeance, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-amber-500 focus:ring-4 focus:ring-amber-100 transition-all duration-200 outline-none text-gray-700 resize-none'}}) }}
                        </div>
                        <div class="flex justify-between mt-2">
                            {{ form_errors(form.objectifSeance) }}
                            <span class="text-xs text-gray-400">Maximum 1000 caractères</span>
                        </div>
                    </div>

                    {# Notes #}
                    <div class="form-group">
                        {{ form_label(form.notes) }}
                        <div class="relative mt-2">
                            <div class="absolute top-4 left-4 flex items-center pointer-events-none">
                                <i class="fas fa-clipboard text-amber-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.notes, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-amber-500 focus:ring-4 focus:ring-amber-100 transition-all duration-200 outline-none text-gray-700 resize-none'}}) }}
                        </div>
                        <div class="flex justify-between mt-2">
                            {{ form_errors(form.notes) }}
                            <span class="text-xs text-gray-400">Maximum 2000 caractères</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Actions #}
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-6 border-t-2 border-gray-100">
                <a href="{{ path('app_session_index') }}" class="w-full sm:w-auto px-8 py-4 rounded-xl border-2 border-gray-200 text-gray-600 font-semibold hover:bg-gray-50 hover:border-gray-300 transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-arrow-left"></i>
                    Annuler
                </a>
                <button type="submit" class="w-full sm:w-auto px-10 py-4 bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1 flex items-center justify-center gap-3 text-lg">
                    <i class="fas fa-save"></i>
                    Enregistrer la Session
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>

<style>
    /* Styles spécifiques pour les inputs */
    input[type="datetime-local"], input[type="date"] {
        color-scheme: light;
    }
    
    /* Animation au focus */
    .form-group:focus-within label {
        color: #4f46e5;
    }
    
    .form-group:focus-within i {
        color: #4f46e5 !important;
    }
</style>
{% endblock %}