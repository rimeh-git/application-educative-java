{% extends 'base.html.twig' %}

{% block title %}Sessions - TSA Thérapie{% endblock %}

{% block body %}
<div class="fade-in">
    {# Header #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 flex items-center gap-3">
                <span class="bg-indigo-100 text-indigo-600 p-3 rounded-2xl">
                    <i class="fas fa-calendar-check text-2xl"></i>
                </span>
                Sessions Thérapeutiques
            </h1>
            <p class="text-gray-500 mt-2 ml-16">Gérez les séances et suivez la progression des enfants</p>
        </div>
        <a href="{{ path('app_session_new') }}" class="group bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-xl shadow-lg hover:shadow-xl transition-all flex items-center gap-2 transform hover:-translate-y-0.5">
            <i class="fas fa-plus transition-transform group-hover:rotate-90"></i>
            <span class="font-medium">Nouvelle Session</span>
        </a>
    </div>

    {# Stats Cards #}
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex items-center gap-4 card-hover">
            <div class="bg-blue-100 text-blue-600 p-3 rounded-lg">
                <i class="fas fa-calendar text-xl"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">{{ sessions|length }}</p>
                <p class="text-sm text-gray-500">Total Sessions</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex items-center gap-4 card-hover">
            <div class="bg-emerald-100 text-emerald-600 p-3 rounded-lg">
                <i class="fas fa-check-circle text-xl"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">{{ sessions|filter(s => s.statut == 'TERMINEE')|length }}</p>
                <p class="text-sm text-gray-500">Terminées</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex items-center gap-4 card-hover">
            <div class="bg-amber-100 text-amber-600 p-3 rounded-lg">
                <i class="fas fa-clock text-xl"></i>
            </div>
            <div>
                <p class="text-2xl font-bold text-gray-900">{{ sessions|filter(s => s.statut == 'EN_COURS')|length }}</p>
                <p class="text-sm text-gray-500">En Cours</p>
            </div>
        </div>
        <div class="bg-white rounded-xl p-4 shadow-sm border border-gray-100 flex items-center gap-4 card-hover">
            <div class="bg-purple-100 text-purple-600 p-3 rounded-lg">
                <i class="fas fa-chart-line text-xl"></i>
            </div>
            <div>
                {% set totalSuivis = 0 %}
                {% for session in sessions %}
                    {% set totalSuivis = totalSuivis + session.suiviProgressions|length %}
                {% endfor %}
                <p class="text-2xl font-bold text-gray-900">{{ totalSuivis }}</p>
                <p class="text-sm text-gray-500">Suivis Créés</p>
            </div>
        </div>
    </div>

    {# Table #}
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date & Heure</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Durée</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Type</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Statut</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Agitation</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Suivis</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                {% for session in sessions %}
                    <tr class="table-row-hover transition-colors">
                        <td class="px-6 py-4">
                            <span class="font-mono text-sm font-semibold text-indigo-600 bg-indigo-50 px-2 py-1 rounded">#{{ session.id }}</span>
                        </td>
                        <td class="px-6 py-4">
                            <div class="flex flex-col">
                                <span class="font-semibold text-gray-900">{{ session.dateHeure ? session.dateHeure|date('d/m/Y') : '-' }}</span>
                                <span class="text-sm text-gray-500">{{ session.dateHeure ? session.dateHeure|date('H:i') : '' }}</span>
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            <span class="inline-flex items-center px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm font-medium">
                                <i class="fas fa-hourglass-half mr-2 text-indigo-500"></i>
                                {{ session.duree }} min
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            <span class="font-medium text-gray-900">{{ session.type }}</span>
                        </td>
                        <td class="px-6 py-4">
                            {% set badgeClass = {
                                'PLANIFIEE': 'bg-blue-100 text-blue-700 border-blue-200',
                                'EN_COURS': 'bg-amber-100 text-amber-700 border-amber-200',
                                'TERMINEE': 'bg-emerald-100 text-emerald-700 border-emerald-200',
                                'ANNULEE': 'bg-rose-100 text-rose-700 border-rose-200'
                            }[session.statut] %}
                            <span class="badge-modern border {{ badgeClass }}">
                                {% if session.statut == 'PLANIFIEE' %}📅
                                {% elseif session.statut == 'EN_COURS' %}▶️
                                {% elseif session.statut == 'TERMINEE' %}✅
                                {% else %}❌{% endif %}
                                {{ session.statut }}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            {% set agitationClass = {
                                'CALME': 'bg-emerald-100 text-emerald-700',
                                'AGITE': 'bg-orange-100 text-orange-700',
                                'CRISE': 'bg-rose-100 text-rose-700'
                            }[session.niveauAgitation] %}
                            <span class="badge-modern {{ agitationClass }}">
                                {% if session.niveauAgitation == 'CALME' %}😊
                                {% elseif session.niveauAgitation == 'AGITE' %}😰
                                {% else %}😭{% endif %}
                                {{ session.niveauAgitation }}
                            </span>
                        </td>
                        <td class="px-6 py-4">
                            {% if session.suiviProgressions|length > 0 %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-800 text-xs font-medium">
                                    {{ session.suiviProgressions|length }} suivi{{ session.suiviProgressions|length > 1 ? 's' : '' }}
                                </span>
                            {% else %}
                                <span class="text-gray-400 text-sm">-</span>
                            {% endif %}
                        </td>
                        
                        {# ============ COLONNE ACTIONS AVEC 3 BOUTONS ============ #}
                        <td class="px-6 py-4">
                            <div class="flex items-center justify-center gap-2">
                                
                                {# 1. BOUTON VOIR (Bleu) #}
                                <a href="{{ path('app_session_show', {'id': session.id}) }}" 
                                   class="group relative w-10 h-10 rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-500 hover:text-white transition-all duration-200 flex items-center justify-center shadow-sm hover:shadow-md hover:scale-110" 
                                   title="Voir les détails">
                                    <i class="fas fa-eye text-sm"></i>
                                    <span class="absolute -bottom-8 left-1/2 -translate-x-1/2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                                        Voir
                                    </span>
                                </a>

                                {# 2. BOUTON MODIFIER (Amber/Orange) #}
                                <a href="{{ path('app_session_edit', {'id': session.id}) }}" 
                                   class="group relative w-10 h-10 rounded-xl bg-amber-50 text-amber-600 hover:bg-amber-500 hover:text-white transition-all duration-200 flex items-center justify-center shadow-sm hover:shadow-md hover:scale-110" 
                                   title="Modifier la session">
                                    <i class="fas fa-edit text-sm"></i>
                                    <span class="absolute -bottom-8 left-1/2 -translate-x-1/2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                                        Modifier
                                    </span>
                                </a>

                                {# 3. BOUTON SUPPRIMER (Rouge) #}
                                <form method="post" action="{{ path('app_session_delete', {'id': session.id}) }}" 
                                      class="inline" 
                                      onsubmit="return confirm('🗑️ Êtes-vous sûr de vouloir supprimer cette session ?\n\nCette action supprimera aussi tous les suivis associés.');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ session.id) }}">
                                    <button type="submit" 
                                            class="group relative w-10 h-10 rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-500 hover:text-white transition-all duration-200 flex items-center justify-center shadow-sm hover:shadow-md hover:scale-110" 
                                            title="Supprimer la session">
                                        <i class="fas fa-trash-alt text-sm"></i>
                                        <span class="absolute -bottom-8 left-1/2 -translate-x-1/2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                                            Supprimer
                                        </span>
                                    </button>
                                </form>

                            </div>
                        </td>
                        {# ============ FIN COLONNE ACTIONS ============ #}
                        
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="px-6 py-12 text-center">
                            <div class="flex flex-col items-center text-gray-400">
                                <div class="bg-gray-100 p-4 rounded-full mb-4">
                                    <i class="fas fa-inbox text-4xl"></i>
                                </div>
                                <p class="text-lg font-medium mb-2">Aucune session trouvée</p>
                                <p class="text-sm mb-4">Commencez par créer votre première session</p>
                                <a href="{{ path('app_session_new') }}" class="text-indigo-600 hover:text-indigo-700 font-medium">
                                    <i class="fas fa-plus mr-1"></i> Créer une session
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}