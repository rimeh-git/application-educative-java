{% extends 'base.html.twig' %}

{% block title %}Suivi des Sessions — TSA Thérapie{% endblock %}

{% block body %}
<div class="fade-in space-y-6">

    {# ══════════════════════════════════════════ HEADER ══════════════════════════════════════════ #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-3xl font-bold text-slate-900">
                <i class="fas fa-chart-line text-emerald-600 mr-3"></i>Suivi des Sessions
            </h1>
            <p class="text-slate-500 mt-1">Suivez la progression des séances terminées</p>
        </div>
        <div class="flex gap-3 flex-wrap">
            <a href="{{ path('app_session_index') }}" class="px-4 py-2 bg-slate-600 text-white rounded-xl hover:bg-slate-700 transition shadow-lg shadow-slate-200 text-sm font-medium flex items-center gap-2">
                <i class="fas fa-list"></i>Toutes les Sessions
            </a>
            <a href="{{ path('app_session_new') }}" class="px-4 py-2 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition shadow-lg shadow-indigo-200 text-sm font-medium flex items-center gap-2">
                <i class="fas fa-plus"></i>Nouvelle Session
            </a>
        </div>
    </div>

    {# ══════════════════════════════════════════ SESSIONS DISPONIBLES ══════════════════════════════════════════ #}
    {% if sessions is empty %}
        <div class="bg-white rounded-2xl p-8 text-center shadow-sm border border-slate-200">
            <i class="fas fa-inbox text-4xl text-slate-300 mb-4"></i>
            <h3 class="text-lg font-semibold text-slate-900 mb-2">Aucune session disponible</h3>
            <p class="text-slate-500">Il n'y a pas de sessions terminées prêtes pour le suivi de progression.</p>
        </div>
    {% else %}
        <div class="grid gap-4">
            {% for session in sessions %}
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 hover:shadow-md transition">
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                        <div class="flex-1">
                            <div class="flex items-start gap-4">
                                <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-xl flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-check-circle text-xl"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <h3 class="text-lg font-semibold text-slate-900 mb-1">
                                        Session #{{ session.id }} - {{ session.type }}
                                    </h3>
                                    <p class="text-slate-600 mb-2">{{ session.objectifSeance ?: 'Aucun objectif défini' }}</p>
                                    <div class="flex flex-wrap gap-4 text-sm text-slate-500">
                                        <span><i class="fas fa-calendar mr-1"></i>{{ session.dateHeure|date('d/m/Y à H:i') }}</span>
                                        <span><i class="fas fa-clock mr-1"></i>{{ session.duree }} min</span>
                                        <span><i class="fas fa-user mr-1"></i>{{ session.nomResponsable ?: 'Non défini' }}</span>
                                        {% if session.telephoneResponsable %}
                                            <span><i class="fas fa-phone mr-1"></i>{{ session.telephoneResponsable }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="flex gap-3 flex-shrink-0">
                            <a href="{{ path('app_session_show', {id: session.id}) }}"
                               class="px-4 py-2 bg-slate-100 text-slate-700 rounded-xl hover:bg-slate-200 transition text-sm font-medium flex items-center gap-2">
                                <i class="fas fa-eye"></i>Voir
                            </a>
                            <a href="{{ path('app_suivi_progression_new', {session: session.id}) }}"
                               class="px-4 py-2 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 transition shadow-lg shadow-emerald-200 text-sm font-medium flex items-center gap-2">
                                <i class="fas fa-plus"></i>Suivre la progression
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        {# ══════════════════════════════════════════ STATS ══════════════════════════════════════════ #}
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
            <h3 class="text-lg font-semibold text-slate-900 mb-4">Résumé</h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="text-center">
                    <div class="text-2xl font-bold text-emerald-600">{{ sessions|length }}</div>
                    <div class="text-sm text-slate-500">Sessions terminées</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-blue-600">
                        {{ sessions|map(s => s.duree)|reduce((carry, item) => carry + item) }}
                    </div>
                    <div class="text-sm text-slate-500">Minutes totales</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-purple-600">
                        {{ sessions|map(s => s.dateHeure)|sort|first|date('d/m/Y') ?: 'N/A' }}
                    </div>
                    <div class="text-sm text-slate-500">Plus ancienne</div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}