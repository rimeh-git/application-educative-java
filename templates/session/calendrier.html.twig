{% extends 'base.html.twig' %}

{% block title %}Calendrier des Sessions — TSA Thérapie{% endblock %}

{% block body %}
<div class="fade-in space-y-6">

    {# ══════════════════════════════════════════ HEADER ══════════════════════════════════════════ #}
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
        <div>
            <h1 class="text-3xl font-bold text-slate-900">
                <i class="fas fa-calendar-alt text-indigo-600 mr-3"></i>Calendrier des Sessions
            </h1>
            <p class="text-slate-500 mt-1">Vue mensuelle des séances thérapeutiques</p>
        </div>
        <div class="flex gap-3 flex-wrap">
            <a href="{{ path('app_session_emploi_temps') }}" class="px-4 py-2 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 transition shadow-lg shadow-emerald-200 text-sm font-medium flex items-center gap-2">
                <i class="fas fa-calendar-week"></i>Emploi du temps
            </a>
            <a href="{{ path('app_session_new') }}" class="px-4 py-2 bg-indigo-600 text-white rounded-xl hover:bg-indigo-700 transition shadow-lg shadow-indigo-200 text-sm font-medium flex items-center gap-2">
                <i class="fas fa-plus"></i>Nouvelle Session
            </a>
        </div>
    </div>

    {# ══════════════════════════════════════════ NAVIGATION MOIS ══════════════════════════════════════════ #}
    <div class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
        <div class="flex items-center justify-between mb-6">
            <button onclick="changeMonth(-1)" class="p-2 hover:bg-slate-100 rounded-lg transition">
                <i class="fas fa-chevron-left text-slate-600"></i>
            </button>

            <h2 class="text-xl font-bold text-slate-900">
                {{ ['Janvier', 'Février', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Août', 'Septembre', 'Octobre', 'Novembre', 'Décembre'][mois - 1] }} {{ annee }}
            </h2>

            <button onclick="changeMonth(1)" class="p-2 hover:bg-slate-100 rounded-lg transition">
                <i class="fas fa-chevron-right text-slate-600"></i>
            </button>
        </div>

        {# ══════════════════════════════════════════ CALENDRIER ══════════════════════════════════════════ #}
        <div class="grid grid-cols-7 gap-1">
            {# Jours de la semaine #}
            {% for jour in ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'] %}
                <div class="p-3 text-center font-semibold text-slate-600 bg-slate-50 rounded-lg">
                    {{ jour }}
                </div>
            {% endfor %}

            {# Jours du mois #}
            {% set premierJour = date(annee ~ '-' ~ mois ~ '-01') %}
            {% set dernierJour = premierJour|date_modify('last day of this month') %}
            {% set jourDebut = premierJour|date('N') - 1 %} {# 0 = Lundi #}

            {# Cases vides avant le premier jour #}
            {% for i in 0..jourDebut - 1 %}
                <div class="p-3 bg-slate-50 rounded-lg min-h-[100px]"></div>
            {% endfor %}

            {# Jours du mois #}
            {% for jour in 1..dernierJour|date('d') %}
                {% set dateCourante = date(annee ~ '-' ~ mois ~ '-' ~ jour) %}
                {% set sessionsJour = sessions|filter(s => s.dateHeure|date('Y-m-d') == dateCourante|date('Y-m-d')) %}

                <div class="p-3 bg-white border border-slate-200 rounded-lg min-h-[100px] hover:bg-slate-50 transition {{ dateCourante|date('Y-m-d') == 'now'|date('Y-m-d') ? 'ring-2 ring-indigo-200 bg-indigo-50' : '' }}">
                    <div class="font-medium text-slate-900 mb-2">{{ jour }}</div>

                    {% for session in sessionsJour %}
                        <div class="text-xs p-1 mb-1 rounded bg-indigo-100 text-indigo-800 border-l-2 border-indigo-500">
                            <div class="font-medium">{{ session.dateHeure|date('H:i') }}</div>
                            <div class="truncate">{{ session.type }}</div>
                        </div>
                    {% endfor %}
                </div>
            {% endfor %}
        </div>
    </div>

    {# ══════════════════════════════════════════ LÉGENDE ══════════════════════════════════════════ #}
    <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200">
        <h3 class="font-semibold text-slate-900 mb-3">Légende</h3>
        <div class="flex flex-wrap gap-4 text-sm">
            <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-indigo-100 border-l-2 border-indigo-500 rounded"></div>
                <span>Session programmée</span>
            </div>
            <div class="flex items-center gap-2">
                <div class="w-4 h-4 bg-indigo-50 ring-2 ring-indigo-200 rounded"></div>
                <span>Aujourd'hui</span>
            </div>
        </div>
    </div>
</div>

<script>
function changeMonth(delta) {
    const url = new URL(window.location);
    let mois = {{ mois }};
    let annee = {{ annee }};

    mois += delta;
    if (mois < 1) {
        mois = 12;
        annee--;
    } else if (mois > 12) {
        mois = 1;
        annee++;
    }

    url.searchParams.set('mois', mois);
    url.searchParams.set('annee', annee);
    window.location = url;
}
</script>
{% endblock %}