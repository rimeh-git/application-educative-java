{% extends 'base.html.twig' %}

{% block title %}Modifier Session #{{ session.id }} - TSA Thérapie{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto fade-in">
    {# Breadcrumb #}
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-6">
        <a href="{{ path('app_session_index') }}" class="hover:text-amber-600 flex items-center gap-1 transition-colors">
            <i class="fas fa-home"></i> Accueil
        </a>
        <i class="fas fa-chevron-right text-xs text-gray-400"></i>
        <a href="{{ path('app_session_index') }}" class="hover:text-amber-600 transition-colors">Sessions</a>
        <i class="fas fa-chevron-right text-xs text-gray-400"></i>
        <span class="text-gray-900 font-semibold">Modifier #{{ session.id }}</span>
    </nav>

    {# Main Card #}
    <div class="bg-white rounded-3xl shadow-2xl border border-gray-100 overflow-hidden">
        {# Header #}
        <div class="relative bg-gradient-to-r from-amber-500 via-orange-500 to-red-500 px-8 py-8 text-white overflow-hidden">
            <div class="absolute top-0 right-0 -mt-4 -mr-4 w-32 h-32 bg-white/10 rounded-full blur-2xl"></div>
            <div class="absolute bottom-0 left-0 -mb-4 -ml-4 w-24 h-24 bg-white/10 rounded-full blur-xl"></div>
            
            <div class="relative z-10">
                <div class="flex items-center gap-4 mb-2">
                    <div class="bg-white/20 backdrop-blur-sm p-3 rounded-2xl">
                        <i class="fas fa-edit text-2xl"></i>
                    </div>
                    <div>
                        <h1 class="text-3xl font-bold">Modifier Session #{{ session.id }}</h1>
                        <p class="text-amber-100 mt-1">Modifiez les informations de la séance</p>
                    </div>
                </div>
            </div>
        </div>

        {# ✅ FORMULAIRE PRINCIPAL SEULEMENT POUR LES CHAMPS #}
        <div class="p-8 lg:p-10">
            {{ form_start(form, {'attr': {'class': 'space-y-8', 'novalidate': 'novalidate'}}) }}
            
            {# Section 1: Informations de base #}
            <div class="bg-amber-50/50 rounded-2xl p-6 border border-amber-100">
                <h3 class="text-lg font-bold text-amber-800 mb-6 flex items-center gap-2">
                    <span class="bg-amber-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">1</span>
                    📋 Informations de base
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="form-group">
                        {{ form_label(form.dateHeure) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-calendar-alt text-amber-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.dateHeure, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-amber-500 focus:ring-4 focus:ring-amber-100 transition-all duration-200 outline-none text-gray-700'}}) }}
                        </div>
                        {{ form_errors(form.dateHeure) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.duree) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-hourglass-half text-amber-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.duree, {'attr': {'class': 'w-full pl-12 pr-20 py-3 rounded-xl border-2 border-gray-200 focus:border-amber-500 focus:ring-4 focus:ring-amber-100 transition-all duration-200 outline-none text-gray-700'}}) }}
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <span class="text-gray-400 font-medium">min</span>
                            </div>
                        </div>
                        {{ form_errors(form.duree) }}
                    </div>
                </div>
            </div>

            {# Section 2: Type et Statut #}
            <div class="bg-orange-50/50 rounded-2xl p-6 border border-orange-100">
                <h3 class="text-lg font-bold text-orange-800 mb-6 flex items-center gap-2">
                    <span class="bg-orange-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">2</span>
                    🎯 Type et Statut
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="form-group">
                        {{ form_label(form.type) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-hand-holding-heart text-orange-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.type, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-orange-500 focus:ring-4 focus:ring-orange-100 transition-all duration-200 outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-orange-400"></i>
                            </div>
                        </div>
                        {{ form_errors(form.type) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.statut) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-tasks text-orange-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.statut, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-orange-500 focus:ring-4 focus:ring-orange-100 transition-all duration-200 outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-orange-400"></i>
                            </div>
                        </div>
                        {{ form_errors(form.statut) }}
                    </div>
                </div>
            </div>

            {# Section 3: Évaluation comportementale #}
            <div class="bg-red-50/50 rounded-2xl p-6 border border-red-100">
                <h3 class="text-lg font-bold text-red-800 mb-6 flex items-center gap-2">
                    <span class="bg-red-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">3</span>
                    😊 Évaluation comportementale
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="form-group">
                        {{ form_label(form.niveauAgitation) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-heart-pulse text-red-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.niveauAgitation, {'attr': {'class': 'w-full pl-12 pr-12 py-3 rounded-xl border-2 border-gray-200 focus:border-red-500 focus:ring-4 focus:ring-red-100 transition-all duration-200 outline-none text-gray-700 appearance-none bg-white cursor-pointer'}}) }}
                            <div class="absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none">
                                <i class="fas fa-chevron-down text-red-400"></i>
                            </div>
                        </div>
                        {{ form_errors(form.niveauAgitation) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.techniqueUtilisee) }}
                        <div class="relative mt-2">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <i class="fas fa-tools text-red-400 text-lg"></i>
                            </div>
                            {{ form_widget(form.techniqueUtilisee, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-red-500 focus:ring-4 focus:ring-red-100 transition-all duration-200 outline-none text-gray-700'}}) }}
                        </div>
                        {{ form_errors(form.techniqueUtilisee) }}
                    </div>
                </div>
            </div>

            {# Section 4: Objectifs et Notes #}
            <div class="bg-yellow-50/50 rounded-2xl p-6 border border-yellow-100">
                <h3 class="text-lg font-bold text-yellow-800 mb-6 flex items-center gap-2">
                    <span class="bg-yellow-600 text-white w-8 h-8 rounded-lg flex items-center justify-center text-sm">4</span>
                    📝 Objectifs et Observations
                </h3>
                
                <div class="space-y-6">
                    <div class="form-group">
                        {{ form_label(form.objectifSeance) }}
                        <div class="relative mt-2">
                            <div class="absolute top-4 left-4 flex items-center pointer-events-none">
                                <i class="fas fa-bullseye text-yellow-500 text-lg"></i>
                            </div>
                            {{ form_widget(form.objectifSeance, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-yellow-500 focus:ring-4 focus:ring-yellow-100 transition-all duration-200 outline-none text-gray-700 resize-none'}}) }}
                        </div>
                        {{ form_errors(form.objectifSeance) }}
                    </div>

                    <div class="form-group">
                        {{ form_label(form.notes) }}
                        <div class="relative mt-2">
                            <div class="absolute top-4 left-4 flex items-center pointer-events-none">
                                <i class="fas fa-clipboard text-yellow-500 text-lg"></i>
                            </div>
                            {{ form_widget(form.notes, {'attr': {'class': 'w-full pl-12 pr-4 py-3 rounded-xl border-2 border-gray-200 focus:border-yellow-500 focus:ring-4 focus:ring-yellow-100 transition-all duration-200 outline-none text-gray-700 resize-none'}}) }}
                        </div>
                        {{ form_errors(form.notes) }}
                    </div>
                </div>
            </div>

            {# ✅ ACTIONS DU FORM PRINCIPAL SEULEMENT #}
            <div class="flex flex-col sm:flex-row items-center justify-end gap-4 pt-6 border-t-2 border-gray-100">
                <a href="{{ path('app_session_index') }}" class="px-8 py-4 rounded-xl border-2 border-gray-200 text-gray-600 font-semibold hover:bg-gray-50 hover:border-gray-300 transition-all flex items-center justify-center gap-2">
                    <i class="fas fa-times"></i>
                    Annuler
                </a>
                <button type="submit" class="px-10 py-4 bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-600 hover:to-orange-600 text-white font-bold rounded-xl shadow-lg hover:shadow-xl transition-all transform hover:-translate-y-1 flex items-center justify-center gap-3 text-lg">
                    <i class="fas fa-save"></i>
                    Mettre à jour
                </button>
            </div>

            {{ form_end(form) }}
        </div>

        {# ✅ FORM DELETE HORS DU FORM PRINCIPAL (EN DEHORS DE p-8 lg:p-10) #}
        <div class="px-8 lg:px-10 pb-8 lg:pb-10 -mt-4">
            <div class="border-t-2 border-gray-100 pt-6">
                <form method="post" action="{{ path('app_session_delete', {'id': session.id}) }}" onsubmit="return confirm('⚠️ Êtes-vous sûr de vouloir supprimer cette session ? Cette action est irréversible et supprimera aussi tous les suivis associés.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ session.id) }}">
                    <button type="submit" class="w-full sm:w-auto px-6 py-4 bg-rose-50 text-rose-600 font-semibold rounded-xl hover:bg-rose-100 transition-all flex items-center justify-center gap-2 border-2 border-rose-200 hover:border-rose-300">
                        <i class="fas fa-trash-alt"></i>
                        Supprimer la session
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    input[type="datetime-local"], input[type="date"] {
        color-scheme: light;
    }
    
    .form-group:focus-within label {
        color: #f59e0b;
    }
    
    .form-group:focus-within i {
        color: #f59e0b !important;
    }
</style>
{% endblock %}