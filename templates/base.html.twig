<!DOCTYPE html>
<html lang="{{ app.request.locale }}" {% if app.request.locale == 'ar' %}dir="rtl"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}TSA Thérapie{% endblock %}</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Cairo:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
    
    <style>
        * { font-family: {% if app.request.locale == 'ar' %}'Cairo'{% else %}'Inter'{% endif %}, sans-serif; }
        body { background: #f1f5f9; }
        
        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 260px;
            height: 100vh;
            background: #1e293b;
            color: #fff;
            z-index: 1000;
            display: flex;
            flex-direction: column;
        }
        [dir="rtl"] .sidebar { left: auto; right: 0; }
        .menu-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 24px;
            margin: 4px 12px;
            border-radius: 10px;
            color: #94a3b8;
            text-decoration: none;
            transition: all 0.3s;
            font-size: 14px;
            font-weight: 500;
        }
        .menu-item:hover, .menu-item.active {
            background: #4f46e5;
            color: #fff;
        }
        .main-wrapper {
            margin-left: 260px;
            min-height: 100vh;
        }
        [dir="rtl"] .main-wrapper { margin-left: 0; margin-right: 260px; }
        .top-header {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 20px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .content-area {
            padding: 32px;
        }
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body data-current-route="{{ app.request.get('_route') }}">
    
    <nav class="sidebar">
        <div class="p-6 border-b border-gray-700">
            <div class="flex items-center gap-3">
                <i class="fas fa-brain text-2xl text-indigo-400"></i>
                <span class="text-xl font-bold">TSA Thérapie</span>
            </div>
        </div>
        
        <div class="flex-1 py-4">
            {% if is_admin is defined and is_admin %}
                <a href="{{ path('app_dashboard_admin') }}" class="menu-item {{ app.request.get('_route') == 'app_dashboard_admin' ? 'active' : '' }}">
                    <i class="fas fa-home"></i><span>{{ 'nav.dashboard'|trans }}</span>
                </a>
                <a href="{{ path('app_session_index') }}" class="menu-item {{ app.request.get('_route') starts with 'app_session' ? 'active' : '' }}">
                    <i class="fas fa-calendar"></i><span>{{ 'nav.sessions'|trans }}</span>
                </a>
                <a href="{{ path('app_session_calendrier') }}" class="menu-item {{ app.request.get('_route') == 'app_session_calendrier' ? 'active' : '' }}">
                    <i class="fas fa-table-cells"></i><span>{{ 'nav.calendar'|trans }}</span>
                </a>
                <a href="{{ path('app_session_stats') }}" class="menu-item {{ app.request.get('_route') == 'app_session_stats' ? 'active' : '' }}">
                    <i class="fas fa-chart-pie"></i><span>{{ 'nav.stats'|trans }}</span>
                </a>
                <a href="{{ path('app_suivi_progression_index') }}" class="menu-item {{ app.request.get('_route') starts with 'app_suivi' ? 'active' : '' }}">
                    <i class="fas fa-chart-line"></i><span>{{ 'nav.suivis'|trans }}</span>
                </a>
            {% else %}
                <a href="{{ path('app_dashboard_user') }}" class="menu-item {{ app.request.get('_route') == 'app_dashboard_user' ? 'active' : '' }}">
                    <i class="fas fa-home"></i><span>{{ 'nav.dashboard'|trans }}</span>
                </a>
                <a href="{{ path('app_session_index') }}" class="menu-item {{ app.request.get('_route') starts with 'app_session' ? 'active' : '' }}">
                    <i class="fas fa-calendar"></i><span>{{ 'nav.sessions'|trans }}</span>
                </a>
                <a href="{{ path('app_session_calendrier') }}" class="menu-item {{ app.request.get('_route') == 'app_session_calendrier' ? 'active' : '' }}">
                    <i class="fas fa-table-cells"></i><span>{{ 'nav.calendar'|trans }}</span>
                </a>
                <a href="{{ path('app_session_stats') }}" class="menu-item {{ app.request.get('_route') == 'app_session_stats' ? 'active' : '' }}">
                    <i class="fas fa-chart-pie"></i><span>{{ 'nav.stats'|trans }}</span>
                </a>
                <a href="{{ path('app_suivi_progression_index') }}" class="menu-item {{ app.request.get('_route') starts with 'app_suivi' ? 'active' : '' }}">
                    <i class="fas fa-chart-line"></i><span>{{ 'nav.suivis'|trans }}</span>
                </a>
            {% endif %}

            <div class="mx-3 my-2 border-t border-gray-700"></div>
            <a href="{{ path('app_prediction_dashboard') }}" class="menu-item {{ app.request.get('_route') starts with 'app_prediction' ? 'active' : '' }}">
                <i class="fas fa-brain text-violet-400"></i>
                <span>Prédiction Abandon</span>
                <span class="ml-auto w-2 h-2 bg-red-400 rounded-full animate-pulse"></span>
            </a>
            <button onclick="toggleChat()" class="menu-item w-full text-left cursor-pointer">
                <i class="fas fa-comment-medical text-indigo-400"></i><span>{{ 'nav.assistant'|trans }}</span>
                <span class="ml-auto w-2 h-2 bg-green-400 rounded-full"></span>
            </button>
        </div>
        
        <div class="p-4 border-t border-gray-700 space-y-3">
            {# Language switcher #}
            <div class="flex items-center gap-2 px-2">
                <i class="fas fa-globe text-gray-400 text-xs"></i>
                <div class="flex gap-1">
                    {% for lang, label in {'fr': 'FR', 'en': 'EN', 'ar': 'ع'} %}
                        <a href="{{ path('app_locale_switch', {'locale': lang}) }}"
                           class="px-2 py-1 rounded text-xs font-bold transition
                               {{ app.request.locale == lang
                                   ? 'bg-indigo-500 text-white'
                                   : 'text-gray-400 hover:text-white hover:bg-gray-700' }}">
                            {{ label }}
                        </a>
                    {% endfor %}
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-indigo-500 flex items-center justify-center text-white font-bold">
                    {{ is_admin is defined and is_admin ? 'A' : 'U' }}
                </div>
                <div>
                    <p class="text-sm font-medium">{{ is_admin is defined and is_admin ? 'Admin' : 'User' }}</p>
                    <p class="text-xs text-gray-400">{{ (is_admin is defined and is_admin ? 'nav.mode_admin' : 'nav.mode_user')|trans }}</p>
                </div>
            </div>
        </div>
    </nav>

    <div class="main-wrapper">
        <header class="top-header">
            <h1 class="text-xl font-bold text-gray-800">
                {% if is_admin is defined and is_admin %}
                    <i class="fas fa-shield-alt mr-2 text-indigo-600"></i>{{ 'nav.admin_space'|trans }}
                {% else %}
                    <i class="fas fa-heart mr-2 text-pink-500"></i>{{ 'nav.family_space'|trans }}
                {% endif %}
            </h1>
            
            <div class="flex items-center gap-4">
                {% if is_admin is defined and is_admin %}
                    <a href="{{ path('app_dashboard_user') }}" class="px-4 py-2 bg-gray-100 rounded-lg text-gray-700 hover:bg-gray-200 transition">
                        <i class="fas fa-exchange-alt mr-2"></i>{{ 'nav.mode_user'|trans }}
                    </a>
                {% else %}
                    <a href="{{ path('app_dashboard_admin') }}" class="px-4 py-2 bg-indigo-100 text-indigo-700 rounded-lg hover:bg-indigo-200 transition">
                        <i class="fas fa-exchange-alt mr-2"></i>{{ 'nav.mode_admin'|trans }}
                    </a>
                {% endif %}
            </div>
        </header>

        <main class="content-area">
            {% block body %}{% endblock %}
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/locales/fr.global.min.js"></script>
    
    {% block javascripts %}{% endblock %}

    {{ include('chatbot/_widget.html.twig') }}
</body>
</html>
