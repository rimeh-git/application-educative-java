<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}AutilLearn{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
.container {
    max-width: 1100px;
    margin: auto;
}

.title {
    margin-bottom: 20px;
}

/* 🔍 SEARCH */
.search-bar {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
}

.search-bar input,
.search-bar select {
    padding: 10px;
    border-radius: 10px;
    border: 1px solid #ccc;
}

/* GRID */
.games-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

/* CARD */
.game-card {
    background: white;
    padding: 15px;
    border-radius: 15px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
    text-align: center;
}

.game-card img {
    width: 100%;
    border-radius: 10px;
}

/* BADGE */
.badge {
    display: inline-block;
    background: orange;
    color: white;
    padding: 5px 12px;
    border-radius: 20px;
    margin: 10px 0;
}

/* BUTTON */
.btn-play {
    display: inline-block;
    background: #2563eb;
    color: white;
    padding: 10px 15px;
    border-radius: 10px;
    text-decoration: none;
}
.container {
    padding: 20px;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
}

.card {
    background: #f3f4f6;
    padding: 15px;
    border-radius: 15px;
}

.btn-back {
    padding: 10px 15px;
    background: #3b82f6;
    color: white;
    border-radius: 8px;
    text-decoration: none;
}
.game-container {
    text-align: center;
    padding: 40px;
}

.quiz-card {
    background: #f5f7fb;
    padding: 20px;
    margin: 20px auto;
    border-radius: 15px;
    width: 400px;
}

.choice-btn {
    display: block;
    margin: 10px auto;
    padding: 10px;
    width: 200px;
    border-radius: 10px;
    border: none;
    background: #e5e7eb;
    cursor: pointer;
}

.intrus-grid {
    display: flex;
    justify-content: center;
    gap: 20px;
}

.intrus-img {
    width: 120px;
    height: 120px;
    border-radius: 10px;
    cursor: pointer;
}
#puzzle img:hover {
    transform: scale(1.05);
    transition: 0.2s;
}
{% extends 'base.html.twig' %}

{% block body %}
<div class="container py-4">

    <h2 class="fw-bold text-center mb-4">🎮 Jeux Éducatifs</h2>

    <!-- 🔍 Recherche auto -->
    <form method="get" id="searchForm" class="d-flex justify-content-center gap-2 mb-4">
        <input type="text" name="search" value="{{ search }}" 
               class="form-control w-25" placeholder="Rechercher..."
               onkeyup="autoSubmit()">

        <select name="sort" class="form-select w-auto" onchange="autoSubmit()">
            <option value="">Trier</option>
            <option value="az" {{ sort == 'az' ? 'selected' }}>A → Z</option>
            <option value="za" {{ sort == 'za' ? 'selected' }}>Z → A</option>
        </select>
    </form>

    <!-- 🎮 Jeux -->
    <div class="row g-4">
        {% for jeu in pagination %}
        <div class="col-md-3">

            <div class="card game-card shadow-sm h-100">

                <img src="{{ asset('uploads/' ~ jeu.image) }}" 
                     class="card-img-top p-3"
                     style="height: 180px; object-fit: contain;">

                <div class="card-body text-center">

                    <h5 class="fw-bold text-capitalize">{{ jeu.type }}</h5>

                    <!-- 🆕 Niveau -->
                    <p class="text-muted mb-1">
                        🎯 Niveau : <strong>{{ jeu.niveau }}</strong>
                    </p>

                    <!-- 🆕 Description -->
                    <p class="small text-secondary">
                        {{ jeu.description|default('Pas de description')|slice(0, 60) }}...
                    </p>

                    <a href="{{ path('play_one_game', {'id': jeu.id}) }}" 
                       class="btn btn-primary w-100">
                        🎮 Jouer
                    </a>

                </div>

            </div>

        </div>
        {% endfor %}
    </div>

    <!-- 📄 Pagination -->
    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(pagination) }}
    </div>

</div>

<!-- ⚡ JS recherche auto -->
<script>
function autoSubmit() {
    clearTimeout(window.timer);
    window.timer = setTimeout(() => {
        document.getElementById('searchForm').submit();
    }, 500);
}
</script>

<!-- 🎨 Style -->
<style>
.game-card {
    border-radius: 15px;
    transition: 0.3s;
}

.game-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.15);
}

.card-img-top {
    transition: 0.3s;
}

.game-card:hover .card-img-top {
    transform: scale(1.05);
}
</style>

{% endblock %}
    </style>
</head>

<body>

{% block body %}{% endblock %}

</body>
</html>