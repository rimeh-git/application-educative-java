{% extends 'base.html.twig' %}

{% block body %}

<div class="container mt-5">
    <h2 class="mb-4">➕ Ajouter Activité ({{ jeu.type }})</h2>

    <div class="card p-4 shadow">

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}

        <div class="mb-3">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.niveau) }}
            {{ form_widget(form.niveau, {'attr': {'class': 'form-control'}}) }}
        </div>

        {# ❓ QUIZ #}
        {% if form.question is defined %}
        <div class="mb-3">
            {{ form_label(form.question) }}
            {{ form_widget(form.question, {'attr': {'class': 'form-control'}}) }}
        </div>
        {% endif %}

        {% if form.choix1 is defined %}
        <div class="mb-3">
            {{ form_widget(form.choix1, {'attr': {'class': 'form-control', 'placeholder':'Choix 1'}}) }}
            {{ form_widget(form.choix2, {'attr': {'class': 'form-control mt-2', 'placeholder':'Choix 2'}}) }}
            {{ form_widget(form.choix3, {'attr': {'class': 'form-control mt-2', 'placeholder':'Choix 3'}}) }}
            {{ form_widget(form.choix4, {'attr': {'class': 'form-control mt-2', 'placeholder':'Choix 4'}}) }}
        </div>
        {% endif %}

        {% if form.bonneReponse is defined %}
        <div class="mb-3">
            {{ form_label(form.bonneReponse) }}
            {{ form_widget(form.bonneReponse, {'attr': {'class': 'form-control'}}) }}
        </div>
        {% endif %}

        {# 🔥 INTRUS = 4 IMAGES #}
        {% if form.image1 is defined %}
        <div class="mb-3">
            <label>Images</label>
            {{ form_widget(form.image1, {'attr': {'class': 'form-control'}}) }}
            {{ form_widget(form.image2, {'attr': {'class': 'form-control mt-2'}}) }}
            {{ form_widget(form.image3, {'attr': {'class': 'form-control mt-2'}}) }}
            {{ form_widget(form.image4, {'attr': {'class': 'form-control mt-2'}}) }}
        </div>
        {% endif %}

        {# 🧩 AUTRES (puzzle/emotion) #}
        {% if form.imageFile is defined %}
        <div class="mb-3">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
        </div>
        {% endif %}

        <button class="btn btn-success">💾 Ajouter</button>

        {{ form_end(form) }}

    </div>
</div>

{% endblock %}