<div class="container-fluid p-4">

    <h2 class="mb-4 fw-bold">Dashboard Administrateur</h2>

    <div class="row">

        {% for jeu in jeux %}
        <div class="col-md-4 mb-4">

            <div class="card custom-card p-4">

                <div class="d-flex align-items-center mb-3">
                    <span class="icon">🎮</span>
                    <h5 class="ms-2">{{ jeu.type }}</h5>
                </div>

                <p>Niveau : {{ jeu.niveau }}</p>

                <div class="mt-3 d-flex gap-2 flex-wrap">

                    <a href="{{ path('activite_list', {'id': jeu.id}) }}" class="btn btn-light btn-sm">
                        📂 Voir activités
                    </a>

                    <a href="{{ path('jeu_edit', {'id': jeu.id}) }}" class="btn btn-warning btn-sm">
                        ✏️ Modifier
                    </a>

                    <a href="{{ path('jeu_delete', {'id': jeu.id}) }}" class="btn btn-danger btn-sm">
                        🗑 Supprimer
                    </a>

                </div>

            </div>

        </div>
        {% endfor %}

    </div>

</div>