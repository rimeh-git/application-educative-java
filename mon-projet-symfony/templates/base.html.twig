<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Jeux</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f5f7fb;
        }
        .card {
            border-radius: 15px;
        }
        .btn {
            border-radius: 10px;
        }
        .custom-card {
    background: linear-gradient(135deg, #5f5fff, #7b5cff);
    color: white;
    border-radius: 20px;
    border: none;
    transition: 0.3s;
}

.custom-card:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

.custom-card .btn {
    border-radius: 20px;
}

.icon {
    font-size: 20px;
}
.hover-card {
    transition: all 0.3s ease;
}

.hover-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
}
    </style>
</head>

<body>

<nav class="navbar navbar-dark bg-dark px-4">
    <span class="navbar-brand">🎮</span>
</nav>

<div class="container mt-4">
    {% block body %}{% endblock %}
</div>

</body>
</html>