<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>AutiLearn 🎮</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: #f5f7fb;
        }

        .card-jeu {
            transition: 0.3s;
            border-radius: 15px;
        }

        .card-jeu:hover {
            transform: scale(1.03);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .niveau {
            font-weight: bold;
        }

        .facile { color: green; }
        .moyen { color: orange; }
        .difficile { color: red; }
    </style>
</head>

<body class="container mt-4">

{% block body %}{% endblock %}

</body>
</html>